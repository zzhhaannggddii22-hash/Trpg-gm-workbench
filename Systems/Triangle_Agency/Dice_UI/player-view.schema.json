{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trpg-gm-workbench:triangle-agency-dice-ui:player-view:v1",
  "title": "Triangle Agency Player Dice View",
  "description": "Recipient-authorized player projection only. No internal event, ledger, manifest or GM-only identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "view_id",
    "revision",
    "recipient_scope",
    "system_id",
    "ruleset_version",
    "mechanic",
    "phase",
    "dice"
  ],
  "properties": {
    "view_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque recipient-scoped view identifier; must not encode internal IDs."
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "recipient_scope": {
      "const": "PLAYER"
    },
    "system_id": {
      "const": "triangle_agency"
    },
    "ruleset_version": {
      "const": "中文 v22"
    },
    "mechanic": {
      "enum": [
        "ASK_THE_AGENCY",
        "ANOMALY_ABILITY"
      ]
    },
    "title": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "DECLARED",
        "ROLLED",
        "AWAITING_PLAYER_CHOICE",
        "RESOLVED",
        "PENDING"
      ]
    },
    "dice": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "status"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "raw_value": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4
          },
          "current_value": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4
          },
          "status": {
            "enum": [
              "ACTIVE",
              "REMOVED"
            ]
          },
          "modifications": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "before",
                "after"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "QA",
                    "BURNOUT",
                    "OTHER_RULE_EFFECT"
                  ]
                },
                "before": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 4
                },
                "after": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 4
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "description": "Six fixed slots for a completed roll; slot uniqueness must be enforced by the upstream semantic validator."
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "chaos": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "natural_triscendence": {
          "type": "boolean"
        },
        "stability": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "player_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice_id",
          "label"
        ],
        "properties": {
          "choice_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "resource_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_label",
          "delta",
          "current_value_status"
        ],
        "properties": {
          "resource_label": {
            "type": "string",
            "minLength": 1
          },
          "delta": {
            "type": "number"
          },
          "current_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "current_value_status": {
            "enum": [
              "VERIFIED",
              "PENDING",
              "NOT_APPLICABLE"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "current_value_status": {
                  "const": "PENDING"
                }
              },
              "required": [
                "current_value_status"
              ]
            },
            "then": {
              "properties": {
                "current_value": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "current_value_status": {
                  "const": "VERIFIED"
                }
              },
              "required": [
                "current_value_status"
              ]
            },
            "then": {
              "required": [
                "current_value"
              ],
              "properties": {
                "current_value": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    "display_notice": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "DECLARED"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "dice": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "AWAITING_PLAYER_CHOICE"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "player_choices"
        ],
        "properties": {
          "player_choices": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "RESOLVED"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              }
            },
            "required": [
              "success"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "PENDING"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "display_notice"
        ],
        "properties": {
          "display_notice": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "ROLLED",
              "AWAITING_PLAYER_CHOICE",
              "RESOLVED"
            ]
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "dice": {
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "required": [
                "slot",
                "status",
                "raw_value"
              ],
              "properties": {
                "raw_value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                }
              }
            }
          }
        }
      }
    }
  ]
}
