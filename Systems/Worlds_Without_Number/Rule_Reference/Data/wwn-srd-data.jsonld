      "@type": "Table",
      "name": "7.5.0 Decreasing Difficulty",
      "slug": "7-5-0-decreasing-difficulty",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "7.5.0",
        "heading": "7.5.0 Decreasing Difficulty",
        "lineStart": 5293,
        "lineEnd": 5326
      },
      "tableType": "7.5.0 Decreasing Difficulty",
      "columns": [
        "Renown Bought",
        "Cost in Silver Pieces per Point"
      ],
      "rows": [
        {
          "position": 1,
          "result": "First 1-4 points",
