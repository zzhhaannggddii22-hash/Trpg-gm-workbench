      },
      "traditionName": "necromancer",
      "level": 2,
      "effects": [
        {
          "sourceText": "The necromancer curses one visible target per level. For the rest of the scene, these targets cannot recover or gain hit points and will die instantly if Mortally Wounded. After each failed instance of healing, a target can make a Physical save to throw off the spell."
        }
      ],
