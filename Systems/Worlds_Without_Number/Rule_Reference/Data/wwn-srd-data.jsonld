    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/inspire-dread",
      "@type": "Art",
      "name": "Inspire Dread",
      "slug": "inspire-dread",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "1.5.3.1 Bard Arts",
        "lineStart": 667,
        "lineEnd": 667
      },
      "rulesText": "Inspire Dread: Commit Effort for the day as an Instant action when your enemies are forced to make a Morale check. You goad their fears, forcing them to make two Morale checks instead of one. Those who succeed on both must still make an Instinct check immediately after.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action when your enemies are forced to make a Morale check. You goad their fears, forcing them to make two Morale checks instead of one. Those who succeed on both must still make an Instinct check immediately after."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/intrinsic-armor",
      "@type": "Art",
      "name": "Intrinsic Armor",
      "slug": "intrinsic-armor",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1921,
        "lineEnd": 1921
      },
      "rulesText": "Intrinsic Armor: This shape has tough scales, hide, shell, or other defensive integuments. Your base Armor Class is 14 plus half your character level, rounded down. This AC can be modified by your Dexterity modifier, and by shields if the shape can hold one.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape has tough scales, hide, shell, or other defensive integuments. Your base Armor Class is 14 plus half your character level, rounded down. This AC can be modified by your Dexterity modifier, and by shields if the shape can hold one."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/iron-resolution",
      "@type": "Art",
      "name": "Iron Resolution",
      "slug": "iron-resolution",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "1.5.10.1 High Mage Arts",
        "lineStart": 1406,
        "lineEnd": 1406
      },
      "rulesText": "Iron Resolution: Commit Effort for the day when injured or disturbed in combat; you may make a Physical saving throw to resist spell disruption and ignore the damage for purposes of spellcasting.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the day when injured or disturbed in combat; you may make a Physical saving throw to resist spell disruption and ignore the damage for purposes of spellcasting."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/keen-senses",
      "@type": "Art",
      "name": "Keen Senses",
      "slug": "keen-senses",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "Partial Warrior/Bard",
        "lineStart": 714,
        "lineEnd": 714
      },
      "rulesText": "Keen Senses: This art gives you the equivalent of sight out to 60’ even if blinded. You cannot distinguish colors, but you can perceive physical details as readily as if with your eyes. Physically-invisible creatures and objects are obvious to you.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "This art gives you the equivalent of sight out to 60’ even if blinded. You cannot distinguish colors, but you can perceive physical details as readily as if with your eyes. Physically-invisible creatures and objects are obvious to you."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/keeper-of-the-gate",
      "@type": "Art",
      "name": "Keeper of the Gate",
      "slug": "keeper-of-the-gate",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "Partial Necromancer Arts and Spells",
        "lineStart": 1779,
        "lineEnd": 1779
      },
      "rulesText": "Keeper of the Gate: At your discretion, creatures within twenty feet of you per character level that are Mortally Wounded will die instantly and cannot be revived by magic or medicine. Conversely, you can Commit Effort for the day to automatically stabilize any or all within that range, increasing their System Strain by 1 point. This benefit cannot aid creatures that have been dismembered, shredded, or otherwise suffered unsurvivable injuries.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "At your discretion, creatures within twenty feet of you per character level that are Mortally Wounded will die instantly and cannot be revived by magic or medicine. Conversely, you can Commit Effort for the day to automatically stabilize any or all within that range, increasing their System Strain by 1 point. This benefit cannot aid creatures that have been dismembered, shredded, or otherwise suffered unsurvivable injuries."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/know-the-weak-spot",
      "@type": "Art",
      "name": "Know the Weak Spot",
      "slug": "know-the-weak-spot",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Other Beastmaster Arts",
        "lineStart": 822,
        "lineEnd": 822
      },
      "rulesText": "Know the Weak Spot: Whenever inflicting damage on a beast with a weapon or physical attack, roll the damage twice and take the higher score. Optionally, Commit Effort for the scene as an Instant action when an ally within earshot hits a beast; your shouted advice or distracting help allows them to roll damage twice and take the better result as well.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Whenever inflicting damage on a beast with a weapon or physical attack, roll the damage twice and take the higher score. Optionally, Commit Effort for the scene as an Instant action when an ally within earshot hits a beast; your shouted advice or distracting help allows them to roll damage twice and take the better result as well."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/know-your-prey",
      "@type": "Art",
      "name": "Know Your Prey",
      "slug": "know-your-prey",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "Mageslayer Art Progression",
        "lineStart": 1694,
        "lineEnd": 1694
      },
      "rulesText": "Know Your Prey: Your Magic skill is treated as one point higher than it is, up to a maximum of level-4 skill. This benefit adds to your Effort as usual, and may allow you to have a higher Magic skill than your character level would usually allow.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "Your Magic skill is treated as one point higher than it is, up to a maximum of level-4 skill. This benefit adds to your Effort as usual, and may allow you to have a higher Magic skill than your character level would usually allow."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/leap-of-the-heavens",
      "@type": "Art",
      "name": "Leap of the Heavens",
      "slug": "leap-of-the-heavens",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2149,
        "lineEnd": 2149
      },
      "rulesText": "Leap of the Heavens: Commit Effort for the scene as a Move action to leap up to your full Move action horizontally or half that vertically. You may also Commit Effort for the scene as an Instant action to negate falling damage, no matter the distance.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Move action to leap up to your full Move action horizontally or half that vertically. You may also Commit Effort for the scene as an Instant action to negate falling damage, no matter the distance."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/liberating-song",
      "@type": "Art",
      "name": "Liberating Song",
      "slug": "liberating-song",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "Partial Warrior/Bard",
        "lineStart": 716,
        "lineEnd": 716
      },
      "rulesText": "Liberating Song: You are immune to mind- or emotion-controlling effects. You can Commit Effort for the scene as an Instant action to grant any ally in range a Mental saving throw to throw off such effects, assuming they allowed a save to begin with. If the second save is failed, this art cannot help them.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "You are immune to mind- or emotion-controlling effects. You can Commit Effort for the scene as an Instant action to grant any ally in range a Mental saving throw to throw off such effects, assuming they allowed a save to begin with. If the second save is failed, this art cannot help them."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/life-bridge",
      "@type": "Art",
      "name": "Life Bridge",
      "slug": "life-bridge",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "Partial Necromancer Arts and Spells",
        "lineStart": 1781,
        "lineEnd": 1781
      },
      "rulesText": "Life Bridge: You can transfer life force between willing or helpless participants. Commit Effort for the day; for the rest of the scene, you can shift hit points from one willing or helpless target no smaller than a dog to another as a Main Action, provided you are touching both. You can shift enough hit points to Mortally Wound a donor, but you can’t give more to the recipient than would refresh their maximum allowed hit points.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "You can transfer life force between willing or helpless participants. Commit Effort for the day; for the rest of the scene, you can shift hit points from one willing or helpless target no smaller than a dog to another as a Main Action, provided you are touching both. You can shift enough hit points to Mortally Wound a donor, but you can’t give more to the recipient than would refresh their maximum allowed hit points."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/lightning-draw",
      "@type": "Art",
      "name": "Lightning Draw",
      "slug": "lightning-draw",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1042,
        "lineEnd": 1042
      },
      "rulesText": "Lightning Draw: Commit Effort for the day as an Instant action at the start of hostilities; you win initiative against anyone without a similar ability to act first and may ready a Stowed favored weapon Instantly.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action at the start of hostilities; you win initiative against anyone without a similar ability to act first and may ready a Stowed favored weapon Instantly."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/limb-restoration",
      "@type": "Art",
      "name": "Limb Restoration",
      "slug": "limb-restoration",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Other Healer Arts",
        "lineStart": 1302,
        "lineEnd": 1302
      },
      "rulesText": "Limb Restoration: Only expert healers can master this art, which cannot be learned earlier than 8th level. You must Commit all remaining Effort for the day, a minimum of one point, to regenerate a missing limb or organ for a target you are touching, or efface some dramatic scar or other physical debility. The target’s System Strain is automatically maximized.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Only expert healers can master this art, which cannot be learned earlier than 8th level. You must Commit all remaining Effort for the day, a minimum of one point, to regenerate a missing limb or organ for a target you are touching, or efface some dramatic scar or other physical debility. The target’s System Strain is automatically maximized."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/luck-blessing",
      "@type": "Art",
      "name": "Luck Blessing",
      "slug": "luck-blessing",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Curses and Blessings",
        "lineStart": 2373,
        "lineEnd": 2373
      },
      "rulesText": "Luck Blessing: As a Main Action, confer a blessing on a visible target. The next skill check they make that day will have a +1 bonus. Only one luck blessing can be in place for a creature at a time.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "As a Main Action, confer a blessing on a visible target. The next skill check they make that day will have a +1 bonus. Only one luck blessing can be in place for a creature at a time."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/lying-face",
      "@type": "Art",
      "name": "Lying Face",
      "slug": "lying-face",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "1.5.2.1 Accursed Arts",
        "lineStart": 564,
        "lineEnd": 564
      },
      "rulesText": "Lying Face: Commit Effort as a Main Action; while it remains Committed, you can disguise yourself as any humanoid of the same general size, including clothing, scent, and voice.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Commit Effort as a Main Action; while it remains Committed, you can disguise yourself as any humanoid of the same general size, including clothing, scent, and voice."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/magebane",
      "@type": "Art",
      "name": "Magebane",
      "slug": "magebane",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "Mageslayer Art Progression",
        "lineStart": 1696,
        "lineEnd": 1696
      },
      "rulesText": "Magebane: You add half your level, rounded up, to all damage you inflict on casters from any source, be it by weapon, Shock, or violent action. This does not stack with a Warrior’s Killing Blow class ability.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "You add half your level, rounded up, to all damage you inflict on casters from any source, be it by weapon, Shock, or violent action. This does not stack with a Warrior’s Killing Blow class ability."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/mageslayer-arts",
      "@type": "Art",
      "name": "Mageslayer Arts",
      "slug": "mageslayer-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "1.5.13.1 Mageslayer Arts",
        "lineStart": 1629,
        "lineEnd": 1642
      },
      "rulesText": "A Mageslayer has an Effort score equal to their Magic skill level plus their highest attribute modifier among Intelligence and Constitution, to a minimum of one point. Mageslayer arts may be used in or out of armor, and require no free hands, incantations, or other overt actions, though some sects have favored prayers or oaths.\n\nA Mageslayer gains their arts at a set rate, beginning with Antimage and Magebane at first level, and acquiring other talents as they gain experience.\n\nAbsolute Negation: As an Instant action, Commit Effort for the day when you are about to be affected or impeded by an unwanted spell or a standing magical effect created by a spell. You may ignore the magic.\n\nAntimage: Get one level of the Nullifier Focus for free, or a free Focus if you somehow have both levels.\n\nDispel Enchantment: As a Main Action, touch an ally and Commit Effort for the day. Your touch acts as an Extirpate Arcana spell. This art can only be applied to creatures, not objects, and can be applied to yourself or a given target only once per day.\n\nDisrupt Sorcery: As an On Turn action, Commit Effort for the scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "A Mageslayer has an Effort score equal to their Magic skill level plus their highest attribute modifier among Intelligence and Constitution, to a minimum of one point. Mageslayer arts may be used in or out of armor, and require no free hands, incantations, or other overt actions, though some sects have favored prayers or oaths.\n\nA Mageslayer gains their arts at a set rate, beginning with Antimage and Magebane at first level, and acquiring other talents as they gain experience.\n\nAbsolute Negation: As an Instant action, Commit Effort for the day when you are about to be affected or impeded by an unwanted spell or a standing magical effect created by a spell. You may ignore the magic.\n\nAntimage: Get one level of the Nullifier Focus for free, or a free Focus if you somehow have both levels.\n\nDispel Enchantment: As a Main Action, touch an ally and Commit Effort for the day. Your touch acts as an Extirpate Arcana spell. This art can only be applied to creatures, not objects, and can be applied to yourself or a given target only once per day.\n\nDisrupt Sorcery: As an On Turn action, Commit Effort for the scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/manifest-wings",
      "@type": "Art",
      "name": "Manifest Wings",
      "slug": "manifest-wings",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1923,
        "lineEnd": 1923
      },
      "rulesText": "Manifest Wings: This shape can form usable wings. You can’t effectively attack while concentrating on remaining aloft, but you can fly at your normal movement rate +10’ per action. If unhindered and flying overland you can travel up to ten miles an hour and fly up to five hours a day.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape can form usable wings. You can’t effectively attack while concentrating on remaining aloft, but you can fly at your normal movement rate +10’ per action. If unhindered and flying overland you can travel up to ten miles an hour and fly up to five hours a day."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/martial-style",
      "@type": "Art",
      "name": "Martial Style",
      "slug": "martial-style",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "1.5.17.1 Vowed Arts",
        "lineStart": 2088,
        "lineEnd": 2088
      },
      "rulesText": "Martial Style: Regardless of class, your hit die can’t be worse than 1d6 per level. When attacking with the Punch skill, your class hit bonus can be no worse than that of an Expert of your same character level. At third level, any attack using the Punch skill counts as a magic weapon.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Regardless of class, your hit die can’t be worse than 1d6 per level. When attacking with the Punch skill, your class hit bonus can be no worse than that of an Expert of your same character level. At third level, any attack using the Punch skill counts as a magic weapon."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/master-of-bones",
      "@type": "Art",
      "name": "Master of Bones",
      "slug": "master-of-bones",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "Partial Necromancer Arts and Spells",
        "lineStart": 1783,
        "lineEnd": 1783
      },
      "rulesText": "Master of Bones: Undead must roll twice to save versus your abilities or spells and take the worse roll. You may Commit Effort for the scene as an Instant action to negate any single attack, magical power or spell an undead uses against you. Undead with more than twice as many hit dice as you have levels cannot be foiled this way.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "Undead must roll twice to save versus your abilities or spells and take the worse roll. You may Commit Effort for the scene as an Instant action to negate any single attack, magical power or spell an undead uses against you. Undead with more than twice as many hit dice as you have levels cannot be foiled this way."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/master-s-vigor",
      "@type": "Art",
      "name": "Master’s Vigor",
      "slug": "master-s-vigor",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2151,
        "lineEnd": 2151
      },
      "rulesText": "Master’s Vigor: Your body retains its vigor and youthful vitality to the full normal span of your life. You regain two lost hit points per hour due to your natural restorative powers.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Your body retains its vigor and youthful vitality to the full normal span of your life. You regain two lost hit points per hour due to your natural restorative powers."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/merciful-healing",
      "@type": "Art",
      "name": "Merciful Healing",
      "slug": "merciful-healing",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "1.5.5.1 Blood Priest Arts",
        "lineStart": 877,
        "lineEnd": 877
      },
      "rulesText": "Merciful Healing: Commit Effort for the day as a Main Action and touch a target within melee range. The target receives 1d6+2 points of magical healing. If done in combat or used to revive a Mortally Wounded subject, the rushed haste of the healing adds 1 System",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action and touch a target within melee range. The target receives 1d6+2 points of magical healing. If done in combat or used to revive a Mortally Wounded subject, the rushed haste of the healing adds 1 System"
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/mind-call",
      "@type": "Art",
      "name": "Mind Call",
      "slug": "mind-call",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Other Beastmaster Arts",
        "lineStart": 824,
        "lineEnd": 824
      },
      "rulesText": "Mind Call: Commit Effort for the scene as an On Turn action. For the rest of the scene you forge a telepathic bond with your animal companion. You can give it orders and receive information from the creature, at least insofar as its limited intellect allows.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action. For the rest of the scene you forge a telepathic bond with your animal companion. You can give it orders and receive information from the creature, at least insofar as its limited intellect allows."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/mind-light",
      "@type": "Art",
      "name": "Mind Light",
      "slug": "mind-light",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2037,
        "lineEnd": 2037
      },
      "rulesText": "Mind Light: Your Open Mind art is enhanced. While active, you become aware of the location of all living minds within sixty feet of you provided there isn’t a physical barrier between you and the subject and they are not actively hiding from you. You can identify the species of these minds, if the species is known to you, any strong emotional states, and can recognize known individuals. While Open Mind is active you cannot be surprised by a living creature.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Your Open Mind art is enhanced. While active, you become aware of the location of all living minds within sixty feet of you provided there isn’t a physical barrier between you and the subject and they are not actively hiding from you. You can identify the species of these minds, if the species is known to you, any strong emotional states, and can recognize known individuals. While Open Mind is active you cannot be surprised by a living creature."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/mind-over-matter",
      "@type": "Art",
      "name": "Mind Over Matter",
      "slug": "mind-over-matter",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2039,
        "lineEnd": 2039
      },
      "rulesText": "Mind Over Matter: Your mental control over your physical processes is considerable. Commit Effort for the day as an Instant action to gain one of the following benefits: automatically stabilize if Mortally Wounded, go without sleep for twenty-four hours, heal 1d6 hit points of damage you’ve suffered, or completely ignore normal climatic extremes of heat or cold for one day. Similar tricks of bodily control may be allowed at the GM’s discretion.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Your mental control over your physical processes is considerable. Commit Effort for the day as an Instant action to gain one of the following benefits: automatically stabilize if Mortally Wounded, go without sleep for twenty-four hours, heal 1d6 hit points of damage you’ve suffered, or completely ignore normal climatic extremes of heat or cold for one day. Similar tricks of bodily control may be allowed at the GM’s discretion."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/mirror-mask",
      "@type": "Art",
      "name": "Mirror Mask",
      "slug": "mirror-mask",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2041,
        "lineEnd": 2041
      },
      "rulesText": "Mirror Mask: You become instantly aware of any mind-affecting power directed at you and can identify the user if they’re within your current sensory range. You may reroll any Mental saving throw the attacking ability allows you; if it doesn’t allow a save, you get a single Mental save to resist anyway. If you succeed, you may Commit Effort for the day as an Instant action to give the power false information of your choice or a false impression of success.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "You become instantly aware of any mind-affecting power directed at you and can identify the user if they’re within your current sensory range. You may reroll any Mental saving throw the attacking ability allows you; if it doesn’t allow a save, you get a single Mental save to resist anyway. If you succeed, you may Commit Effort for the day as an Instant action to give the power false information of your choice or a false impression of success."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/mob-justice",
      "@type": "Art",
      "name": "Mob Justice",
      "slug": "mob-justice",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2153,
        "lineEnd": 2153
      },
      "rulesText": "Mob Justice: As an Instant action, Commit Effort for the day to become impervious to the Make a Swarm Attack maneuver. Your assailants cannot use this maneuver against you for the rest of the scene, and you become immune to Shock as long as you remain in melee with at least two foes. Making use of this benefit disrupts any spellcasting you may attempt, however, due to the violent motion required.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "As an Instant action, Commit Effort for the day to become impervious to the Make a Swarm Attack maneuver. Your assailants cannot use this maneuver against you for the rest of the scene, and you become immune to Shock as long as you remain in melee with at least two foes. Making use of this benefit disrupts any spellcasting you may attempt, however, due to the violent motion required."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/natural-weaponry",
      "@type": "Art",
      "name": "Natural Weaponry",
      "slug": "natural-weaponry",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Other Beastmaster Arts",
        "lineStart": 826,
        "lineEnd": 826
      },
      "rulesText": "Natural Weaponry: You may have physically grown fangs and claws, or it may be that you just intuitively absorbed effective unarmed fighting techniques from your animal companions. When unarmed, your attacks count as weapons that use either Str or Dex as their modifier, use Punch or Stab as the skill, do 1d8 damage, and have a Shock value of 2/AC 13. These unarmed attacks can harm even creatures immune to non-magical weapons. The damage and Shock of these weapons gains a +1 bonus at level 3, a +2 bonus at level 6, and a +3 bonus at level 9.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "You may have physically grown fangs and claws, or it may be that you just intuitively absorbed effective unarmed fighting techniques from your animal companions. When unarmed, your attacks count as weapons that use either Str or Dex as their modifier, use Punch or Stab as the skill, do 1d8 damage, and have a Shock value of 2/AC 13. These unarmed attacks can harm even creatures immune to non-magical weapons. The damage and Shock of these weapons gains a +1 bonus at level 3, a +2 bonus at level 6, and a +3 bonus at level 9."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/necromancer-arts",
      "@type": "Art",
      "name": "Necromancer Arts",
      "slug": "necromancer-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "1.5.14.1 Necromancer Arts",
        "lineStart": 1720,
        "lineEnd": 1733
      },
      "rulesText": "Necromancer Effort is calculated as usual, with each PC’s maximum being equal to one plus their Magic skill level plus the better of their Intelligence or Charisma modifiers. Partial Necromancers have a score one point lower than this, albeit not less than one.\n\nBonetalker: You can see and communicate with any undead creature, regardless of a shared language or the creature’s natural state of invisibility. By Committing Effort for the scene you can sense the surface thoughts of any visible undead, including an impression of any commands or behavior it has been ordered to carry out. Unintelligent undead will not attack you or your companions unless specifically compelled to do so by a command or a master. Even intelligent undead will generally pause at least for an initial parley before attacking.\n\nCold Flesh: You no longer require sleep and feel pain only in an abstract sense. You can suffer no more than 2 points of damage from any given instance of Shock and you have a natural Armor Class equal to 12 plus half your level, rounded down.\n\nConsume Life Energy: By making a Punch attack or using a melee weapon you have spent at least an hour properly consecrating, you can absorb a portion of the damage you inflict on others as healing to yourself. For each successful attack you make with such implements, you heal 1d6 damage, up to a maximum of the damage done by the attack. You cannot drain more life than the target has remaining hit points.\n\nFalse Death: Commit Effort as an Instant action; while it remains Committed you appear dead to all mundane examination. You lose your Main Actions while “dead”, but can move and perceive normally and do not need to eat, drink, breathe, or perform other bodily functions. Poisons and diseases do not progress in you while you are “dead”. You can maintain this state of death for up to one day per level before needing at least an hour to recover.\n\nGravesight: Commit Effort as an On Turn action; while it remains Committed, you can see the life energies of living creatures around you as various glowing patterns, regardless of the mundane illumination available. You can perceive sicknesses, poisons, and other physical qualities on sight. As a side effect of this ability, you can see normally even in perfect blackness.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "Necromancer Effort is calculated as usual, with each PC’s maximum being equal to one plus their Magic skill level plus the better of their Intelligence or Charisma modifiers. Partial Necromancers have a score one point lower than this, albeit not less than one.\n\nBonetalker: You can see and communicate with any undead creature, regardless of a shared language or the creature’s natural state of invisibility. By Committing Effort for the scene you can sense the surface thoughts of any visible undead, including an impression of any commands or behavior it has been ordered to carry out. Unintelligent undead will not attack you or your companions unless specifically compelled to do so by a command or a master. Even intelligent undead will generally pause at least for an initial parley before attacking.\n\nCold Flesh: You no longer require sleep and feel pain only in an abstract sense. You can suffer no more than 2 points of damage from any given instance of Shock and you have a natural Armor Class equal to 12 plus half your level, rounded down.\n\nConsume Life Energy: By making a Punch attack or using a melee weapon you have spent at least an hour properly consecrating, you can absorb a portion of the damage you inflict on others as healing to yourself. For each successful attack you make with such implements, you heal 1d6 damage, up to a maximum of the damage done by the attack. You cannot drain more life than the target has remaining hit points.\n\nFalse Death: Commit Effort as an Instant action; while it remains Committed you appear dead to all mundane examination. You lose your Main Actions while “dead”, but can move and perceive normally and do not need to eat, drink, breathe, or perform other bodily functions. Poisons and diseases do not progress in you while you are “dead”. You can maintain this state of death for up to one day per level before needing at least an hour to recover.\n\nGravesight: Commit Effort as an On Turn action; while it remains Committed, you can see the life energies of living creatures around you as various glowing patterns, regardless of the mundane illumination available. You can perceive sicknesses, poisons, and other physical qualities on sight. As a side effect of this ability, you can see normally even in perfect blackness."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/night-black-eyes",
      "@type": "Art",
      "name": "Night-Black Eyes",
      "slug": "night-black-eyes",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "1.5.2.1 Accursed Arts",
        "lineStart": 566,
        "lineEnd": 566
      },
      "rulesText": "Night-Black Eyes: You can see clearly in perfect darkness. As",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "You can see clearly in perfect darkness. As"
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/nimble-ascent",
      "@type": "Art",
      "name": "Nimble Ascent",
      "slug": "nimble-ascent",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2155,
        "lineEnd": 2155
      },
      "rulesText": "Nimble Ascent: Commit Effort for the scene as an On Turn action. For the remainder of the scene you may move up vertical and overhanging surfaces and across difficult terrain at your full movement rate with no chance of slipping or falling, provided the surface is not glass-smooth or enchanted. You require only one free hand to cling to a wall or ceiling.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action. For the remainder of the scene you may move up vertical and overhanging surfaces and across difficult terrain at your full movement rate with no chance of slipping or falling, provided the surface is not glass-smooth or enchanted. You require only one free hand to cling to a wall or ceiling."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/octopus-embrace",
      "@type": "Art",
      "name": "Octopus’ Embrace",
      "slug": "octopus-embrace",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1925,
        "lineEnd": 1925
      },
      "rulesText": "Octopus’ Embrace: This shape can have more than four usable limbs. These additional tentacles, arms, legs, or grippers can hold and manipulate things; up to four Stowed objects can be held Ready by these limbs without counting against your Readied Encumbrance limit. These extra limbs cannot effectively employ extra shields, perform additional attacks or actions, or do other things that require significant focus beyond your current action.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape can have more than four usable limbs. These additional tentacles, arms, legs, or grippers can hold and manipulate things; up to four Stowed objects can be held Ready by these limbs without counting against your Readied Encumbrance limit. These extra limbs cannot effectively employ extra shields, perform additional attacks or actions, or do other things that require significant focus beyond your current action."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/open-mind",
      "@type": "Art",
      "name": "Open Mind",
      "slug": "open-mind",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "1.5.16.1 Thought Noble Arts",
        "lineStart": 1974,
        "lineEnd": 1974
      },
      "rulesText": "Open Mind: Commit Effort as an On Turn action. While Effort remains Committed, you may detect the current emotional state of a visible living creature as a Main Action. This discernment isn’t fine enough to identify the object of their emotions unless it’s obvious from the context.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action. While Effort remains Committed, you may detect the current emotional state of a visible living creature as a Main Action. This discernment isn’t fine enough to identify the object of their emotions unless it’s obvious from the context."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/pacted-protection",
      "@type": "Art",
      "name": "Pacted Protection",
      "slug": "pacted-protection",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 615,
        "lineEnd": 615
      },
      "rulesText": "Pacted Protection: Choose a type of harmful energy: fire, frost, acid, electricity, or the like. You become immune to natural degrees of this energy and take half damage from magical attacks involving it.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Choose a type of harmful energy: fire, frost, acid, electricity, or the like. You become immune to natural degrees of this energy and take half damage from magical attacks involving it."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/pavis-of-elements",
      "@type": "Art",
      "name": "Pavis of Elements",
      "slug": "pavis-of-elements",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Partial Elementalist Arts and Spells",
        "lineStart": 1144,
        "lineEnd": 1144
      },
      "rulesText": "Pavis of Elements: Commit Effort as an On Turn action to conjure an elemental barrier around yourself. The barrier improves your Armor Class by +4 and remains as long as the Effort remains Committed. This bonus stacks with other effects, but cannot increase AC above 18, regardless of the combinations.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action to conjure an elemental barrier around yourself. The barrier improves your Armor Class by +4 and remains as long as the Effort remains Committed. This bonus stacks with other effects, but cannot increase AC above 18, regardless of the combinations."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/perfect-mimicry",
      "@type": "Art",
      "name": "Perfect Mimicry",
      "slug": "perfect-mimicry",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1927,
        "lineEnd": 1927
      },
      "rulesText": "Perfect Mimicry: This alternate form can exactly duplicate another creature, provided you either have a lock of their hair, a still-liquid drop of their blood, or ten minutes of observation of them from within five feet. Once learned, you need no further samples.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This alternate form can exactly duplicate another creature, provided you either have a lock of their hair, a still-liquid drop of their blood, or ten minutes of observation of them from within five feet. Once learned, you need no further samples."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/personal-impunity",
      "@type": "Art",
      "name": "Personal Impunity",
      "slug": "personal-impunity",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Example Art Progressions for Different Types of Wise",
        "lineStart": 2349,
        "lineEnd": 2349
      },
      "rulesText": "Personal Impunity: You bear signs of sanctity, and physically harming you is considered taboo in this region. Only the most vicious or desperate humans will initiate violence against you, though any will fight if you attack them. Hostile groups will hesitate to attack your companions unless provoked.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "You bear signs of sanctity, and physically harming you is considered taboo in this region. Only the most vicious or desperate humans will initiate violence against you, though any will fight if you attack them. Hostile groups will hesitate to attack your companions unless provoked."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/petrifying-stare",
      "@type": "Art",
      "name": "Petrifying Stare",
      "slug": "petrifying-stare",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Partial Elementalist Arts and Spells",
        "lineStart": 1146,
        "lineEnd": 1146
      },
      "rulesText": "Petrifying Stare: Commit Effort for the day as a Main Action and target a visible creature. The creature must make a Physical save or become partially petrified, losing its Move action for a number of rounds equal to half your caster level, rounded up. Flying creatures are forced to land by this art and swimming creatures will inevitably sink to the bottom.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action and target a visible creature. The creature must make a Physical save or become partially petrified, losing its Move action for a number of rounds equal to half your caster level, rounded up. Flying creatures are forced to land by this art and swimming creatures will inevitably sink to the bottom."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/piercing-strike",
      "@type": "Art",
      "name": "Piercing Strike",
      "slug": "piercing-strike",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1044,
        "lineEnd": 1044
      },
      "rulesText": "Piercing Strike: Commit Effort for the scene as an On Turn action and choose a visible target. For the rest of the scene, their AC is treated as 10 for purposes of resisting the Shock of your favored weapon.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action and choose a visible target. For the rest of the scene, their AC is treated as 10 for purposes of resisting the Shock of your favored weapon."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/pliant-flesh",
      "@type": "Art",
      "name": "Pliant Flesh",
      "slug": "pliant-flesh",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1929,
        "lineEnd": 1929
      },
      "rulesText": "Pliant Flesh: You’ve mastered your shapeshifting skills, and Change Form can be used as an On Turn action, albeit only once per round. Alternately, it can take as long as a minute but cost no Effort. Whenever you spend Effort to shift shape, you heal lost hit points equal to 1d6 plus your level; this does not apply when merely reverting a form’s change. This art is intrinsic to you, and doesn’t count against the total number of arts allowed to apply to a form.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "You’ve mastered your shapeshifting skills, and Change Form can be used as an On Turn action, albeit only once per round. Alternately, it can take as long as a minute but cost no Effort. Whenever you spend Effort to shift shape, you heal lost hit points equal to 1d6 plus your level; this does not apply when merely reverting a form’s change. This art is intrinsic to you, and doesn’t count against the total number of arts allowed to apply to a form."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/positive-association",
      "@type": "Art",
      "name": "Positive Association",
      "slug": "positive-association",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2043,
        "lineEnd": 2043
      },
      "rulesText": "Positive Association: As a Main Action, Commit Effort for the day and target a visible sentient creature. It gets a Mental saving throw to resist; on a failure, any thought of you or your actions is suffused by a glow of benign happiness and admiration. They will treat you as an admired friend and find all your actions to be eminently reasonable and wise until you or your allies attack them, bring harm to something they love, or leave their presence for more than an hour. Affected creatures that were not misused are unlikely to think themselves bespelled when this power ends unless given reason to. This ability can affect only one target at a time.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "As a Main Action, Commit Effort for the day and target a visible sentient creature. It gets a Mental saving throw to resist; on a failure, any thought of you or your actions is suffused by a glow of benign happiness and admiration. They will treat you as an admired friend and find all your actions to be eminently reasonable and wise until you or your allies attack them, bring harm to something they love, or leave their presence for more than an hour. Affected creatures that were not misused are unlikely to think themselves bespelled when this power ends unless given reason to. This ability can affect only one target at a time."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/preparatory-countermagic",
      "@type": "Art",
      "name": "Preparatory Countermagic",
      "slug": "preparatory-countermagic",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "1.5.10.1 High Mage Arts",
        "lineStart": 1408,
        "lineEnd": 1408
      },
      "rulesText": "Preparatory Countermagic: Commit Effort for the scene when you are affected by a spell you have prepared, including when you are standing in the area of effect of one of your own damaging spells. You are unaffected by the spell’s direct effects.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene when you are affected by a spell you have prepared, including when you are standing in the area of effect of one of your own damaging spells. You are unaffected by the spell’s direct effects."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/psychic-conversion",
      "@type": "Art",
      "name": "Psychic Conversion",
      "slug": "psychic-conversion",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "Partial High Mage Arts and Spells",
        "lineStart": 1455,
        "lineEnd": 1455
      },
      "rulesText": "Psychic Conversion: Once per day as an On Turn action, expend one casting slot to remove one point of accrued System Strain and heal 2 hit points per level.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Once per day as an On Turn action, expend one casting slot to remove one point of accrued System Strain and heal 2 hit points per level."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/purge-ailment",
      "@type": "Art",
      "name": "Purge Ailment",
      "slug": "purge-ailment",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Partial Warrior/Healer",
        "lineStart": 1349,
        "lineEnd": 1349
      },
      "rulesText": "Purge Ailment: Commit Effort for the day as a Main Action. An ally you are touching is cured of one poison or disease. Creatures killed by poison can be revived by this art if it is used within six minutes of death. Magical poisons and diseases may require a Wis/Heal or Cha/Heal skill check against a difficulty of 8 or more. At seventh level, you need only Commit Effort for the scene to use this ability.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action. An ally you are touching is cured of one poison or disease. Creatures killed by poison can be revived by this art if it is used within six minutes of death. Magical poisons and diseases may require a Wis/Heal or Cha/Heal skill check against a difficulty of 8 or more. At seventh level, you need only Commit Effort for the scene to use this ability."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/purified-body",
      "@type": "Art",
      "name": "Purified Body",
      "slug": "purified-body",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2157,
        "lineEnd": 2157
      },
      "rulesText": "Purified Body: You may Commit Effort for the day as an Instant action to cure any disease or poison currently affecting you, or instead to negate any need for sleep, food, water, or air for the next 24 hours.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "You may Commit Effort for the day as an Instant action to cure any disease or poison currently affecting you, or instead to negate any need for sleep, food, water, or air for the next 24 hours."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/rally",
      "@type": "Art",
      "name": "Rally",
      "slug": "rally",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "Partial Warrior/Bard",
        "lineStart": 718,
        "lineEnd": 718
      },
      "rulesText": "Rally: Commit Effort for the day as a Main Action to exhort a wounded or fallen ally, removing any Frailty. The target regains 2d6 plus your level in hit points, but you incur one System Strain.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action to exhort a wounded or fallen ally, removing any Frailty. The target regains 2d6 plus your level in hit points, but you incur one System Strain."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/read-intent",
      "@type": "Art",
      "name": "Read Intent",
      "slug": "read-intent",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Thought Noble Arts",
        "lineStart": 2060,
        "lineEnd": 2060
      },
      "rulesText": "Read Intent: As an Instant action, Commit Effort for the scene and target a visible living creature. It gets a Mental saving throw to resist; on a failure, the GM will tell you exactly what it is currently intending to do on its next turn, or its next relevant action if used out of combat. If you perform a Total Defense action this round, your insight into its motions ensures that no attack it makes that you could theoretically physically avoid can hit you for the rest of the round.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "As an Instant action, Commit Effort for the scene and target a visible living creature. It gets a Mental saving throw to resist; on a failure, the GM will tell you exactly what it is currently intending to do on its next turn, or its next relevant action if used out of combat. If you perform a Total Defense action this round, your insight into its motions ensures that no attack it makes that you could theoretically physically avoid can hit you for the rest of the round."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/read-omens",
      "@type": "Art",
      "name": "Read Omens",
      "slug": "read-omens",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Divination Arts",
        "lineStart": 2361,
        "lineEnd": 2361
      },
      "rulesText": "Read Omens: A petitioner proposes a course of action to the PC. After a scene-long ritual involving at least 10 sp worth of livestock or sacrificial material, the GM makes a secret Wis/Magic skill check against difficulty 10. On a success, the PC gets an impression of whether the course of action will lead to success or failure, as the GM thinks most likely. On a failure, the GM gives a random result. Multiplying the ritual costs by 10 adds +1 to the skill check, thus, a sacrifice of 1,000 sp worth of livestock gets a +2 on the check. The same course of action cannot be divined more than once a month.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "A petitioner proposes a course of action to the PC. After a scene-long ritual involving at least 10 sp worth of livestock or sacrificial material, the GM makes a secret Wis/Magic skill check against difficulty 10. On a success, the PC gets an impression of whether the course of action will lead to success or failure, as the GM thinks most likely. On a failure, the GM gives a random result. Multiplying the ritual costs by 10 adds +1 to the skill check, thus, a sacrifice of 1,000 sp worth of livestock gets a +2 on the check. The same course of action cannot be divined more than once a month."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/red-harvest",
      "@type": "Art",
      "name": "Red Harvest",
      "slug": "red-harvest",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "Partial Necromancer Arts and Spells",
        "lineStart": 1785,
        "lineEnd": 1785
      },
      "rulesText": "Red Harvest: You are empowered by death. As an Instant action, whenever an intelligent living creature with at least one hit die perishes within fifty feet of you, Commit Effort for the day to either heal 1d6 plus your level in lost hit points or gain a +4 bonus on your next hit roll this scene. This art cannot be stacked, and it can be used only once per round.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "You are empowered by death. As an Instant action, whenever an intelligent living creature with at least one hit die perishes within fifty feet of you, Commit Effort for the day to either heal 1d6 plus your level in lost hit points or gain a +4 bonus on your next hit roll this scene. This art cannot be stacked, and it can be used only once per round."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/refined-restoration",
      "@type": "Art",
      "name": "Refined Restoration",
      "slug": "refined-restoration",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Partial Warrior/Healer",
        "lineStart": 1351,
        "lineEnd": 1351
      },
      "rulesText": "Refined Restoration: You and up to a dozen allies you tend before they sleep will all lose 2 System Strain from a good night’s rest instead of 1.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "You and up to a dozen allies you tend before they sleep will all lose 2 System Strain from a good night’s rest instead of 1."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/restrained-casting",
      "@type": "Art",
      "name": "Restrained Casting",
      "slug": "restrained-casting",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "Partial High Mage Arts and Spells",
        "lineStart": 1457,
        "lineEnd": 1457
      },
      "rulesText": "Restrained Casting: Commit Effort for the day as an Instant action when casting a High Magic spell. You may do so in perfect silence and without need for somatic gestures, though damage will still disrupt the casting.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action when casting a High Magic spell. You may do so in perfect silence and without need for somatic gestures, though damage will still disrupt the casting."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/retain-sorcery",
      "@type": "Art",
      "name": "Retain Sorcery",
      "slug": "retain-sorcery",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "Partial High Mage Arts and Spells",
        "lineStart": 1459,
        "lineEnd": 1459
      },
      "rulesText": "Retain Sorcery: Commit Effort for the day as an On Turn action after casting a spell; it does not count against your casting limits for the day. You can use this art no more than once per day, and the stress of using it prevents you from casting another spell before the end of your next turn.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action after casting a spell; it does not count against your casting limits for the day. You can use this art no more than once per day, and the stress of using it prevents you from casting another spell before the end of your next turn."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/revive-the-fallen",
      "@type": "Art",
      "name": "Revive the Fallen",
      "slug": "revive-the-fallen",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Partial Warrior/Healer",
        "lineStart": 1353,
        "lineEnd": 1353
      },
      "rulesText": "Revive the Fallen: Only expert healers are capable of mastering this art, which cannot be learned earlier than 8th level. Commit Effort for the day as a Main Action to revive a recently-slain living creature that you are touching. This ability must be used on a target within one minute per caster level of their death, and will not work on a corpse that has been dismembered, incinerated, or otherwise disjected. The target’s System Strain is automatically maximized and they’ll be unconscious for twenty-four hours after their restoration before awakening with 1 hit point.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Only expert healers are capable of mastering this art, which cannot be learned earlier than 8th level. Commit Effort for the day as a Main Action to revive a recently-slain living creature that you are touching. This ability must be used on a target within one minute per caster level of their death, and will not work on a corpse that has been dismembered, incinerated, or otherwise disjected. The target’s System Strain is automatically maximized and they’ll be unconscious for twenty-four hours after their restoration before awakening with 1 hit point."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/revivifying-breath",
      "@type": "Art",
      "name": "Revivifying Breath",
      "slug": "revivifying-breath",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2159,
        "lineEnd": 2159
      },
      "rulesText": "Revivifying Breath: Commit Effort for the day as an On Turn action to heal yourself for 1d6 hit points plus your level. This healing does not increase System Strain. This ability may be used on your turn even when you are at zero hit points, but in such a case it Commits all your remaining Effort for the day. This art can be used once per scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action to heal yourself for 1d6 hit points plus your level. This healing does not increase System Strain. This ability may be used on your turn even when you are at zero hit points, but in such a case it Commits all your remaining Effort for the day. This art can be used once per scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/rob-vitality",
      "@type": "Art",
      "name": "Rob Vitality",
      "slug": "rob-vitality",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 617,
        "lineEnd": 617
      },
      "rulesText": "Rob Vitality: Once per scene, as an On Turn action, Commit Effort for the scene and target a visible foe. They must make a Physical save or lose their next Main Action, which you immediately gain instead.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Once per scene, as an On Turn action, Commit Effort for the scene and target a visible foe. They must make a Physical save or lose their next Main Action, which you immediately gain instead."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/rune-of-destruction",
      "@type": "Art",
      "name": "Rune of Destruction",
      "slug": "rune-of-destruction",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Partial Elementalist Arts and Spells",
        "lineStart": 1148,
        "lineEnd": 1148
      },
      "rulesText": "Rune of Destruction: Commit Effort for the day as a Main Action and target an adjacent solid surface. A glowing rune the size of a handprint forms on the surface and persists for one hour per caster level. Any creature who gets within two feet of the rune will trigger it, causing it to explode in a five-foot radius with an elemental force of your choice and suffering 2d6 damage plus your caster level. Creatures already within five feet of the rune when it is laid will not trigger it until they re-enter the area, nor will the caster trigger their own runes. Runes cannot overlap their areas of effect.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action and target an adjacent solid surface. A glowing rune the size of a handprint forms on the surface and persists for one hour per caster level. Any creature who gets within two feet of the rune will trigger it, causing it to explode in a five-foot radius with an elemental force of your choice and suffering 2d6 damage plus your caster level. Creatures already within five feet of the rune when it is laid will not trigger it until they re-enter the area, nor will the caster trigger their own runes. Runes cannot overlap their areas of effect."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/sanctified-ward",
      "@type": "Art",
      "name": "Sanctified Ward",
      "slug": "sanctified-ward",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "Partial Warrior/Blood Priest",
        "lineStart": 924,
        "lineEnd": 924
      },
      "rulesText": "Sanctified Ward: Commit Effort as an On Turn action. While the Effort is maintained and until you take some hostile action against a creature, you are immune to Shock damage and gain a +4 bonus to your Armor Class and all saving throws. Enemies must pass an Instinct check each round to target you with attacks; on a failure, they may take some other action instead. Once this art is ended it cannot be reactivated for the rest of the scene. Healing and other indirect support of fighting comrades does not count as a hostile action.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action. While the Effort is maintained and until you take some hostile action against a creature, you are immune to Shock damage and gain a +4 bonus to your Armor Class and all saving throws. Enemies must pass an Instinct check each round to target you with attacks; on a failure, they may take some other action instead. Once this art is ended it cannot be reactivated for the rest of the scene. Healing and other indirect support of fighting comrades does not count as a hostile action."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/savage-senses",
      "@type": "Art",
      "name": "Savage Senses",
      "slug": "savage-senses",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Partial Beastmaster",
        "lineStart": 843,
        "lineEnd": 843
      },
      "rulesText": "Savage Senses: Commit Effort for the scene as an On Turn action. For the remainder of the scene you are capable of seeing clearly even in pitch blackness, can scent out trails and belongings as perfectly as a wolf could, and gain a +2 bonus on all Notice skill checks involving sight, sound, or smell.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action. For the remainder of the scene you are capable of seeing clearly even in pitch blackness, can scent out trails and belongings as perfectly as a wolf could, and gain a +2 bonus on all Notice skill checks involving sight, sound, or smell."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/savage-talons",
      "@type": "Art",
      "name": "Savage Talons",
      "slug": "savage-talons",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1931,
        "lineEnd": 1931
      },
      "rulesText": "Savage Talons: This shape has extremely dangerous claws, fangs, pincers, or other body weapons. At first level these weapons do 1d8 damage, use either Str or Dex as the modifying attribute, Punch as the combat skill, and have a Shock value of 2/AC 13. At level 3 the damage and Shock increase by +1, at level 6 they increase to +2, and at level 9 they increase to +3. These weapons can harm even creatures immune to non-magical weaponry.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape has extremely dangerous claws, fangs, pincers, or other body weapons. At first level these weapons do 1d8 damage, use either Str or Dex as the modifying attribute, Punch as the combat skill, and have a Shock value of 2/AC 13. At level 3 the damage and Shock increase by +1, at level 6 they increase to +2, and at level 9 they increase to +3. These weapons can harm even creatures immune to non-magical weaponry."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/scourging-curse",
      "@type": "Art",
      "name": "Scourging Curse",
      "slug": "scourging-curse",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 619,
        "lineEnd": 619
      },
      "rulesText": "Scourging Curse: Commit Effort for the scene as a Main Action and target a visible foe. Your curse inflicts a -1 penalty to their hit, damage, and saving throw rolls for one round per level. At 4th level this penalty becomes -2, and at 9th it becomes -3. Only one such curse can be active at a given time.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Main Action and target a visible foe. Your curse inflicts a -1 penalty to their hit, damage, and saving throw rolls for one round per level. At 4th level this penalty becomes -2, and at 9th it becomes -3. Only one such curse can be active at a given time."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/sculptor-s-beauty",
      "@type": "Art",
      "name": "Sculptor’s Beauty",
      "slug": "sculptor-s-beauty",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Skinshifter Arts and Form Bonus",
        "lineStart": 1948,
        "lineEnd": 1948
      },
      "rulesText": "Sculptor’s Beauty: You’ve developed a refined aesthetic sense that can directly appeal to the subconscious beauty preferences of viewers. This shape improves your Charisma modifier by +1, to a maximum of +2. There is always something alien about this beauty, and such forms can never be mistaken for an entirely normal human or animal, though they may be taken for some exotic demihuman or altered baseline.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "You’ve developed a refined aesthetic sense that can directly appeal to the subconscious beauty preferences of viewers. This shape improves your Charisma modifier by +1, to a maximum of +2. There is always something alien about this beauty, and such forms can never be mistaken for an entirely normal human or animal, though they may be taken for some exotic demihuman or altered baseline."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/sense-magic",
      "@type": "Art",
      "name": "Sense Magic",
      "slug": "sense-magic",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "Partial High Mage Arts and Spells",
        "lineStart": 1461,
        "lineEnd": 1461
      },
      "rulesText": "Sense Magic: Commit Effort as an Instant action; while it remains committed, you can visually perceive magical energy and get a one-sentence description of the effect of any standing magics or magical items you inspect. The ambient magical energies in most areas allow you to see clearly even in conditions of perfect darkness.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort as an Instant action; while it remains committed, you can visually perceive magical energy and get a one-sentence description of the effect of any standing magics or magical items you inspect. The ambient magical energies in most areas allow you to see clearly even in conditions of perfect darkness."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/serpent-s-kiss",
      "@type": "Art",
      "name": "Serpent’s Kiss",
      "slug": "serpent-s-kiss",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Skinshifter Arts and Form Bonus",
        "lineStart": 1950,
        "lineEnd": 1950
      },
      "rulesText": "Serpent’s Kiss: This shape can exude a venom on its claws or fangs. Successful hits allow you to Commit Effort for the scene as an Instant action to inflict an additional 1d8 damage plus your Survive skill. You can elect to make the toxin paralytic rather than fatal; foes reduced to zero hit points by such a blow are paralyzed and helpless for an hour rather than mortally wounded.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape can exude a venom on its claws or fangs. Successful hits allow you to Commit Effort for the scene as an Instant action to inflict an additional 1d8 damage plus your Survive skill. You can elect to make the toxin paralytic rather than fatal; foes reduced to zero hit points by such a blow are paralyzed and helpless for an hour rather than mortally wounded."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/shadowed-steps",
      "@type": "Art",
      "name": "Shadowed Steps",
      "slug": "shadowed-steps",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 621,
        "lineEnd": 621
      },
      "rulesText": "Shadowed Steps: As a Move Action, Commit Effort for the scene and teleport up to your Move distance. You cannot bypass walls or physical obstacles, but you can teleport vertically or into high places.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "As a Move Action, Commit Effort for the scene and teleport up to your Move distance. You cannot bypass walls or physical obstacles, but you can teleport vertically or into high places."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/share-the-pain",
      "@type": "Art",
      "name": "Share the Pain",
      "slug": "share-the-pain",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "Mageslayer Art Progression",
        "lineStart": 1698,
        "lineEnd": 1698
      },
      "rulesText": "Share the Pain: As an Instant action, Commit Effort for the day when you are targeted by a hostile spell or are in its area of effect. Make a Mental saving throw; on a success, the spell’s caster is treated as also having affected by the spell that just targeted you. This art can be used only once per round.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "As an Instant action, Commit Effort for the day when you are targeted by a hostile spell or are in its area of effect. Make a Mental saving throw; on a success, the spell’s caster is treated as also having affected by the spell that just targeted you. This art can be used only once per round."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/shared-vitality",
      "@type": "Art",
      "name": "Shared Vitality",
      "slug": "shared-vitality",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Partial Beastmaster",
        "lineStart": 845,
        "lineEnd": 845
      },
      "rulesText": "Shared Vitality: The animal companions you bind have hit dice no lower than your level, even if they normally have far fewer. Thus, a 2 hit die beast bound by a 7th level Beastmaster would have 7 hit dice while it remained bound. Its hit bonus can’t be less than half its hit dice, rounded up. A Beastmaster can stabilize a Mortally Wounded companion by Committing Effort for the scene as an Instant action.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "The animal companions you bind have hit dice no lower than your level, even if they normally have far fewer. Thus, a 2 hit die beast bound by a 7th level Beastmaster would have 7 hit dice while it remained bound. Its hit bonus can’t be less than half its hit dice, rounded up. A Beastmaster can stabilize a Mortally Wounded companion by Committing Effort for the scene as an Instant action."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/shattering-strike",
      "@type": "Art",
      "name": "Shattering Strike",
      "slug": "shattering-strike",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2161,
        "lineEnd": 2161
      },
      "rulesText": "Shattering Strike: Commit Effort for the day and take a full round of motionlessness to prepare. On the next round, as a Main Action, your unarmed attack can shatter a wooden door, wooden wall, or other similar object up to a depth of one foot per level and a width sufficient to allow a man-sized creature to pass through. At fourth level this ability improves to affect even a stone wall and at seventh it can affect even a metal wall or solid iron door. The blow is useless against a target that can move, but against an immobilized creature the attack does 1d12 damage per character level.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Commit Effort for the day and take a full round of motionlessness to prepare. On the next round, as a Main Action, your unarmed attack can shatter a wooden door, wooden wall, or other similar object up to a depth of one foot per level and a width sufficient to allow a man-sized creature to pass through. At fourth level this ability improves to affect even a stone wall and at seventh it can affect even a metal wall or solid iron door. The blow is useless against a target that can move, but against an immobilized creature the attack does 1d12 damage per character level."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/skilled",
      "@type": "Art",
      "name": "Skilled",
      "slug": "skilled",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Example Art Progressions for Different Types of Wise",
        "lineStart": 2351,
        "lineEnd": 2351
      },
      "rulesText": "Skilled: Gain three skill points to spend on any non-combat skills, up to the maximum skill level allowed by your character level. This art may be taken more than once.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "Gain three skill points to spend on any non-combat skills, up to the maximum skill level allowed by your character level. This art may be taken more than once."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/skinshifter-arts",
      "@type": "Art",
      "name": "Skinshifter Arts",
      "slug": "skinshifter-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "1.5.15.1 Skinshifter Arts",
        "lineStart": 1862,
        "lineEnd": 1867
      },
      "rulesText": "Skinshifter Effort is based on Survive, and is equal to the PC’s Survive skill level plus the highest of their Constitution or Charisma modifiers, to a minimum of one point. All Skinshifters begin play with the Change Form art and one more of their choice. Additional arts are learned as the PC advances in experience.\n\nChange Form: Commit Effort for the day as a Main Action to transform into an available Alternate form. This shift persists until you die, shift to a new form, or end the transformation as an On Turn action. Your hit points, System Strain, and other scores remain the same in any new form, but in a non-humanoid form your class’ base attack bonus can be no worse than the one listed on the table. If your shape is quadrupedal, its Move is 10’ faster than your base.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "Skinshifter Effort is based on Survive, and is equal to the PC’s Survive skill level plus the highest of their Constitution or Charisma modifiers, to a minimum of one point. All Skinshifters begin play with the Change Form art and one more of their choice. Additional arts are learned as the PC advances in experience.\n\nChange Form: Commit Effort for the day as a Main Action to transform into an available Alternate form. This shift persists until you die, shift to a new form, or end the transformation as an On Turn action. Your hit points, System Strain, and other scores remain the same in any new form, but in a non-humanoid form your class’ base attack bonus can be no worse than the one listed on the table. If your shape is quadrupedal, its Move is 10’ faster than your base."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/smite-the-wicked",
      "@type": "Art",
      "name": "Smite the Wicked",
      "slug": "smite-the-wicked",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "Partial Warrior/Blood Priest",
        "lineStart": 926,
        "lineEnd": 926
      },
      "rulesText": "Smite the Wicked: Commit Effort for the day as a On Turn action whenever you attack or take some damaging action toward a single target. You gain a +4 bonus to any hit roll, you inflict your character level as automatic damage, and you can roll any damage dice twice and take the higher result. This ability can only be used once per scene on a given target.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a On Turn action whenever you attack or take some damaging action toward a single target. You gain a +4 bonus to any hit roll, you inflict your character level as automatic damage, and you can roll any damage dice twice and take the higher result. This ability can only be used once per scene on a given target."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/snaring-speech",
      "@type": "Art",
      "name": "Snaring Speech",
      "slug": "snaring-speech",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 623,
        "lineEnd": 623
      },
      "rulesText": "Snaring Speech: Once per round as an Instant action, Commit Effort for the day when failing a skill check to persuade or tempt someone. They must make a Mental save or agree with your proposal if it’s something they would normally consider doing. Gain one System Strain when using this art.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Once per round as an Instant action, Commit Effort for the day when failing a skill check to persuade or tempt someone. They must make a Mental save or agree with your proposal if it’s something they would normally consider doing. Gain one System Strain when using this art."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/soothe-the-savage",
      "@type": "Art",
      "name": "Soothe the Savage",
      "slug": "soothe-the-savage",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "Partial Warrior/Bard",
        "lineStart": 718,
        "lineEnd": 718
      },
      "rulesText": "Soothe the Savage: Commit Effort for the day as a Main Action. For as long as you keep spending a Main Action performing each round, animals and other living bestial creatures will not attack you or your allies unless commanded by their masters or threatened by the party. This art can’t be triggered once actual combat has begun.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action. For as long as you keep spending a Main Action performing each round, animals and other living bestial creatures will not attack you or your allies unless commanded by their masters or threatened by the party. This art can’t be triggered once actual combat has begun."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/soothing-graces",
      "@type": "Art",
      "name": "Soothing Graces",
      "slug": "soothing-graces",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "Partial Warrior/Bard",
        "lineStart": 718,
        "lineEnd": 718
      },
      "rulesText": "Soothing Graces: Your arts restore and hearten those with you. You and your allies lose an extra point of System Strain after each night’s comfortable rest. This does not stack with similar rest-aiding powers.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Your arts restore and hearten those with you. You and your allies lose an extra point of System Strain after each night’s comfortable rest. This does not stack with similar rest-aiding powers."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/sorcerous-battery",
      "@type": "Art",
      "name": "Sorcerous Battery",
      "slug": "sorcerous-battery",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 625,
        "lineEnd": 625
      },
      "rulesText": "Sorcerous Battery: Once per day, as an On Turn action, Commit Effort for the day. You or a visible ally refresh the spell slot of a spell that has been cast since the start of the prior round. Gain one System Strain.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Once per day, as an On Turn action, Commit Effort for the day. You or a visible ally refresh the spell slot of a spell that has been cast since the start of the prior round. Gain one System Strain."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/soul-consumption",
      "@type": "Art",
      "name": "Soul Consumption",
      "slug": "soul-consumption",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 627,
        "lineEnd": 627
      },
      "rulesText": "Soul Consumption: As an Instant action, Commit Effort for the day when you fell an intelligent target with Accursed Bolt or Accursed Blade. They die instantly. You heal 1d6 hit points plus your level and lose one accumulated System Strain.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "As an Instant action, Commit Effort for the day when you fell an intelligent target with Accursed Bolt or Accursed Blade. They die instantly. You heal 1d6 hit points plus your level and lose one accumulated System Strain."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/spellshield",
      "@type": "Art",
      "name": "Spellshield",
      "slug": "spellshield",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "Mageslayer Art Progression",
        "lineStart": 1700,
        "lineEnd": 1700
      },
      "rulesText": "Spellshield: When a spell inflicts hit point damage on you, it’s automatically halved, rounded down, before any saves or resistances are applied.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "When a spell inflicts hit point damage on you, it’s automatically halved, rounded down, before any saves or resistances are applied."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/spiritual-weapon",
      "@type": "Art",
      "name": "Spiritual Weapon",
      "slug": "spiritual-weapon",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1046,
        "lineEnd": 1046
      },
      "rulesText": "Spiritual Weapon: You are able to translate examples of your favored weapon into a spiritual template that you may manifest as you wish. Any favored weapon can be turned into such a template, including a magical weapon, but the process destroys the object’s physical form. To manifest a template, Commit Effort as an Instant action; a ghostly copy of the weapon appears Readied in hand for you until you release the Effort or stop touching the weapon. Dual-wielders can summon the same weapon into both hands with one use of this art.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "You are able to translate examples of your favored weapon into a spiritual template that you may manifest as you wish. Any favored weapon can be turned into such a template, including a magical weapon, but the process destroys the object’s physical form. To manifest a template, Commit Effort as an Instant action; a ghostly copy of the weapon appears Readied in hand for you until you release the Effort or stop touching the weapon. Dual-wielders can summon the same weapon into both hands with one use of this art."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/steps-of-air",
      "@type": "Art",
      "name": "Steps of Air",
      "slug": "steps-of-air",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Partial Elementalist Arts and Spells",
        "lineStart": 1150,
        "lineEnd": 1150
      },
      "rulesText": "Steps of Air: Commit Effort for the scene as an On Turn action and target a visible ally; for one round per caster level, the target can fly at their usual movement rate. If the art ends while they are still in the air, they descend harmlessly to the ground. This art may also be used as an Instant action to negate falling damage for any single target.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action and target a visible ally; for one round per caster level, the target can fly at their usual movement rate. If the art ends while they are still in the air, they descend harmlessly to the ground. This art may also be used as an Instant action to negate falling damage for any single target."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/stunning-shock",
      "@type": "Art",
      "name": "Stunning Shock",
      "slug": "stunning-shock",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Partial Elementalist Arts and Spells",
        "lineStart": 1152,
        "lineEnd": 1152
      },
      "rulesText": "Stunning Shock: Commit Effort for the day as a Main Action and target a visible creature within fifty feet per caster level. The target creature must be wearing or holding at least a pound worth of conductive metal or be considerably dampened. An electrical bolt leaps from the caster to stun the target, causing them to lose their next Main Action. A Physical saving throw can mitigate the effect, causing the target to lose their Move action instead of their Main. A creature can be targeted only once per scene by this.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action and target a visible creature within fifty feet per caster level. The target creature must be wearing or holding at least a pound worth of conductive metal or be considerably dampened. An electrical bolt leaps from the caster to stun the target, causing them to lose their next Main Action. A Physical saving throw can mitigate the effect, causing the target to lose their Move action instead of their Main. A creature can be targeted only once per scene by this."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/style-weaponry",
      "@type": "Art",
      "name": "Style Weaponry",
      "slug": "style-weaponry",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2163,
        "lineEnd": 2163
      },
      "rulesText": "Style Weaponry: Pick three general classes of weapons, such as “swords”, “bows”, “axes”, “daggers”, or the like. When using weapons of those classes, you may use Punch for hit rolls instead of Stab or Shoot. Your Punch skill does not add to the damage done by these weapons, however, though the benefits of Martial Style apply to their hit rolls.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Pick three general classes of weapons, such as “swords”, “bows”, “axes”, “daggers”, or the like. When using weapons of those classes, you may use Punch for hit rolls instead of Stab or Shoot. Your Punch skill does not add to the damage done by these weapons, however, though the benefits of Martial Style apply to their hit rolls."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/suppress-magic",
      "@type": "Art",
      "name": "Suppress Magic",
      "slug": "suppress-magic",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "Partial High Mage Arts and Spells",
        "lineStart": 1463,
        "lineEnd": 1463
      },
      "rulesText": "Suppress Magic: Commit Effort for the day as an On Turn action and target a visible or known magical effect within one hundred feet. The effect is suppressed as if by the Extirpate Arcana spell for 1d6 rounds plus the caster’s character level. Spells cast by more powerful casters may not be successfully suppressed, as noted in the spell description. The caster can attempt to suppress an effect only once.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action and target a visible or known magical effect within one hundred feet. The effect is suppressed as if by the Extirpate Arcana spell for 1d6 rounds plus the caster’s character level. Spells cast by more powerful casters may not be successfully suppressed, as noted in the spell description. The caster can attempt to suppress an effect only once."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/surface-apprehension",
      "@type": "Art",
      "name": "Surface Apprehension",
      "slug": "surface-apprehension",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Thought Noble Arts",
        "lineStart": 2062,
        "lineEnd": 2062
      },
      "rulesText": "Surface Apprehension: Commit Effort for the scene as a Main Action while targeting a visible living creature. If it fails a Mental saving throw, you become aware of its immediate surface thoughts for the rest of the round. If you ask specific questions of the creature during this round it will instinctively think of the answers, though the detail of these surface thoughts is generally limited to one or two sentences of information.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Main Action while targeting a visible living creature. If it fails a Mental saving throw, you become aware of its immediate surface thoughts for the rest of the round. If you ask specific questions of the creature during this round it will instinctively think of the answers, though the detail of these surface thoughts is generally limited to one or two sentences of information."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/swift-casting",
      "@type": "Art",
      "name": "Swift Casting",
      "slug": "swift-casting",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "Partial High Mage Arts and Spells",
        "lineStart": 1465,
        "lineEnd": 1465
      },
      "rulesText": "Swift Casting: Once per scene, you may Commit Effort for the day to turn a spell that normally requires a Main Action to cast into an On Turn action. You can cast no other spell this round and you can’t use this art if you’ve already cast a spell this round or been injured or otherwise disqualified from casting.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Once per scene, you may Commit Effort for the day to turn a spell that normally requires a Main Action to cast into an On Turn action. You can cast no other spell this round and you can’t use this art if you’ve already cast a spell this round or been injured or otherwise disqualified from casting."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/swift-healer",
      "@type": "Art",
      "name": "Swift Healer",
      "slug": "swift-healer",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Partial Warrior/Healer",
        "lineStart": 1355,
        "lineEnd": 1355
      },
      "rulesText": "Swift Healer: Your Healing Touch ability is improved, and may be used as an On Turn action once per day per character level, though not more than once per round on any given target.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Your Healing Touch ability is improved, and may be used as an On Turn action once per day per character level, though not more than once per round on any given target."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/swift-healing",
      "@type": "Art",
      "name": "Swift Healing",
      "slug": "swift-healing",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Partial Beastmaster",
        "lineStart": 847,
        "lineEnd": 847
      },
      "rulesText": "Swift Healing: Commit Effort for the day as a Main Action to heal 1d6 damage per character level to a wounded companion. This healing can be extended only once per scene or fifteen minutes.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action to heal 1d6 damage per character level to a wounded companion. This healing can be extended only once per scene or fifteen minutes."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/swift-misdirection",
      "@type": "Art",
      "name": "Swift Misdirection",
      "slug": "swift-misdirection",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "Partial Warrior/Bard",
        "lineStart": 718,
        "lineEnd": 718
      },
      "rulesText": "Swift Misdirection: Commit Effort for the scene as a Main Action and target one intelligent creature within earshot. Tell them something in no more than one sentence; unless what you say is physically impossible or emotionally unendurable, they must make a Mental save or believe it for one round. After that, they can judge your words with their normal reason. This art can affect a creature only once per scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Main Action and target one intelligent creature within earshot. Tell them something in no more than one sentence; unless what you say is physically impossible or emotionally unendurable, they must make a Mental save or believe it for one round. After that, they can judge your words with their normal reason. This art can affect a creature only once per scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/tendrils-of-night",
      "@type": "Art",
      "name": "Tendrils of Night",
      "slug": "tendrils-of-night",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 629,
        "lineEnd": 629
      },
      "rulesText": "Tendrils of Night: Commit Effort as an On Turn action. While Committed, you exude numerous tentacles or eldritch arms that can manipulate objects with your strength up to 20’ away. You gain no bonus actions, but the arms can melee at range. These arms have your AC, and you are damaged if they are hurt.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action. While Committed, you exude numerous tentacles or eldritch arms that can manipulate objects with your strength up to 20’ away. You gain no bonus actions, but the arms can melee at range. These arms have your AC, and you are damaged if they are hurt."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/the-healer-s-knife",
      "@type": "Art",
      "name": "The Healer’s Knife",
      "slug": "the-healer-s-knife",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Partial Warrior/Healer",
        "lineStart": 1357,
        "lineEnd": 1357
      },
      "rulesText": "The Healer’s Knife: Your Healing Touch ability is altered, and may be used to inflict damage to a living target instead of healing it. The damage done is equivalent to the healing that would normally be done, albeit you receive 1 System Strain instead of the target. Using this power in melee requires a successful Punch attack with a hit bonus equal to your Heal skill, with the damage added to any done by the blow, or simply touching an unwary target. Ranged use with Far Healer is impossible with this art.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Your Healing Touch ability is altered, and may be used to inflict damage to a living target instead of healing it. The damage done is equivalent to the healing that would normally be done, albeit you receive 1 System Strain instead of the target. Using this power in melee requires a successful Punch attack with a hit bonus equal to your Heal skill, with the damage added to any done by the blow, or simply touching an unwary target. Ranged use with Far Healer is impossible with this art."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/the-inward-eye",
      "@type": "Art",
      "name": "The Inward Eye",
      "slug": "the-inward-eye",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2147,
        "lineEnd": 2147
      },
      "rulesText": "The Inward Eye: Commit Effort as an On Turn action. For as long as it remains Committed, you are mystically aware of your surroundings with a sense equivalent to normal eyesight regardless of darkness, obscuring mists, or your actual eyes being closed or blinded.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action. For as long as it remains Committed, you are mystically aware of your surroundings with a sense equivalent to normal eyesight regardless of darkness, obscuring mists, or your actual eyes being closed or blinded."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/the-light-of-faith",
      "@type": "Art",
      "name": "The Light of Faith",
      "slug": "the-light-of-faith",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "Partial Warrior/Blood Priest",
        "lineStart": 928,
        "lineEnd": 928
      },
      "rulesText": "The Light of Faith: Commit Effort as an On Turn action; while it remains Committed, you can cast a clear, bright radiance that extends up to thirty feet away from you. At your discretion, this light is visible only to you and your comrades, including up to a dozen allies.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action; while it remains Committed, you can cast a clear, bright radiance that extends up to thirty feet away from you. At your discretion, this light is visible only to you and your comrades, including up to a dozen allies."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/the-monkey-s-road",
      "@type": "Art",
      "name": "The Monkey’s Road",
      "slug": "the-monkey-s-road",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Skinshifter Arts and Form Bonus",
        "lineStart": 1952,
        "lineEnd": 1952
      },
      "rulesText": "The Monkey’s Road: This shape has an arboreal agility when it comes to climbing. You can travel up sheer surfaces at your usual movement rate provided at least three limbs are available for use and the surface is not glassily smooth. If you fall, you can halt your plunge without damage so long as a serviceable surface to cling to is within ten feet of you.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape has an arboreal agility when it comes to climbing. You can travel up sheer surfaces at your usual movement rate provided at least three limbs are available for use and the surface is not glassily smooth. If you fall, you can halt your plunge without damage so long as a serviceable surface to cling to is within ten feet of you."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/thermal-shield",
      "@type": "Art",
      "name": "Thermal Shield",
      "slug": "thermal-shield",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Partial Elementalist Arts and Spells",
        "lineStart": 1154,
        "lineEnd": 1154
      },
      "rulesText": "Thermal Shield: Commit Effort for the scene as an Instant action to immediately negate one instance of fire or frost damage to any single visible ally or object. This defense lasts only long enough to nullify the single instance of damage.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an Instant action to immediately negate one instance of fire or frost damage to any single visible ally or object. This defense lasts only long enough to nullify the single instance of damage."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/thought-noble-arts",
      "@type": "Art",
      "name": "Thought Noble Arts",
      "slug": "thought-noble-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "1.5.16.1 Thought Noble Arts",
        "lineStart": 1968,
        "lineEnd": 1975
      },
      "rulesText": "Thought Noble Effort is calculated with Notice rather than Magic, with each PC’s maximum being equal to their Notice skill level plus the better of their Intelligence or Wisdom modifiers, to a minimum of one point.\n\nAll Thought Nobles are trained in the Open Mind art, but may develop other techniques with time. If an art allows a saving throw to resist it, success renders the target immune to that art for the rest of the scene. Thought Noble arts are all entirely invisible to any but magical senses and provide no hint as to who is using them, even on a successful Mental saving throw.\n\nOpen Mind: Commit Effort as an On Turn action. While Effort remains Committed, you may detect the current emotional state of a visible living creature as a Main Action. This discernment isn’t fine enough to identify the object of their emotions unless it’s obvious from the context.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Thought Noble Effort is calculated with Notice rather than Magic, with each PC’s maximum being equal to their Notice skill level plus the better of their Intelligence or Wisdom modifiers, to a minimum of one point.\n\nAll Thought Nobles are trained in the Open Mind art, but may develop other techniques with time. If an art allows a saving throw to resist it, success renders the target immune to that art for the rest of the scene. Thought Noble arts are all entirely invisible to any but magical senses and provide no hint as to who is using them, even on a successful Mental saving throw.\n\nOpen Mind: Commit Effort as an On Turn action. While Effort remains Committed, you may detect the current emotional state of a visible living creature as a Main Action. This discernment isn’t fine enough to identify the object of their emotions unless it’s obvious from the context."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/thoughts-like-razors",
      "@type": "Art",
      "name": "Thoughts Like Razors",
      "slug": "thoughts-like-razors",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Thought Noble Arts",
        "lineStart": 2064,
        "lineEnd": 2064
      },
      "rulesText": "Thoughts Like Razors: As a Main Action, Commit Effort for the day to launch a psychic assault on any visible living creature within sixty feet. The target gets a Mental saving throw to resist; on a failure, it takes 1d8 damage per level of the Thought Noble. The damage can knock it unconscious but cannot kill. On a successful save, the Thought Noble is stunned by the backlash, taking one quarter of the damage, rounded down, and losing their next turn’s actions. This ability can be used only once per scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "As a Main Action, Commit Effort for the day to launch a psychic assault on any visible living creature within sixty feet. The target gets a Mental saving throw to resist; on a failure, it takes 1d8 damage per level of the Thought Noble. The damage can knock it unconscious but cannot kill. On a successful save, the Thought Noble is stunned by the backlash, taking one quarter of the damage, rounded down, and losing their next turn’s actions. This ability can be used only once per scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/tireless-vigor",
      "@type": "Art",
      "name": "Tireless Vigor",
      "slug": "tireless-vigor",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Partial Warrior/Healer",
        "lineStart": 1359,
        "lineEnd": 1359
      },
      "rulesText": "Tireless Vigor: Commit Effort; while it remains Committed your need to eat, drink, breathe, or sleep does not grow further. You may exert yourself tirelessly and regenerate 1 lost hit point per hour.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Commit Effort; while it remains Committed your need to eat, drink, breathe, or sleep does not grow further. You may exert yourself tirelessly and regenerate 1 lost hit point per hour."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/tongue-of-the-beasts",
      "@type": "Art",
      "name": "Tongue of the Beasts",
      "slug": "tongue-of-the-beasts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Partial Beastmaster",
        "lineStart": 849,
        "lineEnd": 849
      },
      "rulesText": "Tongue of the Beasts: Commit Effort as an On Turn action. While the Effort remains committed, you can speak with any animal that has fur, feathers, scales, or skin. This art allows them to temporarily speak as if they had human intellect, though their interests, knowledge, and desires do not change.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action. While the Effort remains committed, you can speak with any animal that has fur, feathers, scales, or skin. This art allows them to temporarily speak as if they had human intellect, though their interests, knowledge, and desires do not change."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/transubstantiation",
      "@type": "Art",
      "name": "Transubstantiation",
      "slug": "transubstantiation",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "Partial Warrior/Blood Priest",
        "lineStart": 930,
        "lineEnd": 930
      },
      "rulesText": "Transubstantiation: Commit Effort for the day as a Main Action to transform up to a gallon of any liquid into sacred blood. A draught of this holy liquid is sufficient to sustain a drinker for a day without further food or drink and will heal 1d6 plus the user’s Pray skill in lost hit points. A gallon of blood is sufficient to help a half-dozen people. The benefits of this art can be enjoyed only once per day, and any undrunk blood sublimates away within a minute.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action to transform up to a gallon of any liquid into sacred blood. A draught of this holy liquid is sufficient to sustain a drinker for a day without further food or drink and will heal 1d6 plus the user’s Pray skill in lost hit points. A gallon of blood is sufficient to help a half-dozen people. The benefits of this art can be enjoyed only once per day, and any undrunk blood sublimates away within a minute."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/turn-false-life",
      "@type": "Art",
      "name": "Turn False Life",
      "slug": "turn-false-life",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "Partial Warrior/Blood Priest",
        "lineStart": 932,
        "lineEnd": 932
      },
      "rulesText": "Turn False Life: Commit Effort for the day as a Main Action and make the sign of your god before one or more visible targets within sixty feet. Roll 2d6 and add your character level; that many hit dice of undead, automatons, or other synthetic, extraplanar, or unnatural life forms must make Mental saving throws or cower for the rest of the scene or until they or their comrades are attacked. Cowering enemies will take no hostile action and may flee unless bound to their location. This power does not affect foes with twice as many hit dice as the blood priest has levels. If the rolled hit die total isn’t enough to fully affect a creature, it is unaffected.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action and make the sign of your god before one or more visible targets within sixty feet. Roll 2d6 and add your character level; that many hit dice of undead, automatons, or other synthetic, extraplanar, or unnatural life forms must make Mental saving throws or cower for the rest of the scene or until they or their comrades are attacked. Cowering enemies will take no hostile action and may flee unless bound to their location. This power does not affect foes with twice as many hit dice as the blood priest has levels. If the rolled hit die total isn’t enough to fully affect a creature, it is unaffected."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unaging",
      "@type": "Art",
      "name": "Unaging",
      "slug": "unaging",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "Partial Necromancer Arts and Spells",
        "lineStart": 1787,
        "lineEnd": 1787
      },
      "rulesText": "Unaging: You no longer naturally age, and will remain perfectly hale and vigorous up to your species’ natural maximum age plus 20% per character level, after which you will collapse into dust and decay. Immortality beyond this point is possible, but generally requires consistent supplies of life energy, occult materials, or other difficult-to-acquire or morally questionable materials. You also become immune to poisons and diseases.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "You no longer naturally age, and will remain perfectly hale and vigorous up to your species’ natural maximum age plus 20% per character level, after which you will collapse into dust and decay. Immortality beyond this point is possible, but generally requires consistent supplies of life energy, occult materials, or other difficult-to-acquire or morally questionable materials. You also become immune to poisons and diseases."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unarmed-might",
      "@type": "Art",
      "name": "Unarmed Might",
      "slug": "unarmed-might",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "1.5.17.1 Vowed Arts",
        "lineStart": 2090,
        "lineEnd": 2090
      },
      "rulesText": "Unarmed Might: Your unarmed attack damage increases as you gain levels, as noted on the chart. You may add your Punch skill to the damage done by these attacks as usual, but Foci such as Unarmed Combatant that replace or improve your usual Punch damage do not apply to you.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Your unarmed attack damage increases as you gain levels, as noted on the chart. You may add your Punch skill to the damage done by these attacks as usual, but Foci such as Unarmed Combatant that replace or improve your usual Punch damage do not apply to you."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unarmored-defense",
      "@type": "Art",
      "name": "Unarmored Defense",
      "slug": "unarmored-defense",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "1.5.17.1 Vowed Arts",
        "lineStart": 2092,
        "lineEnd": 2092
      },
      "rulesText": "Unarmored Defense: When not wearing armor or using a shield, your base Armor Class is equal to 13 plus half your character level, rounded down.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "When not wearing armor or using a shield, your base Armor Class is equal to 13 plus half your character level, rounded down."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unbindable",
      "@type": "Art",
      "name": "Unbindable",
      "slug": "unbindable",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1048,
        "lineEnd": 1048
      },
      "rulesText": "Unbindable: Commit Effort for the day as an On Turn action whenever you wish to escape chains, grapples, shackles, ropes, or even a magical spell of physical binding. You automatically wriggle free from mundane restraints and gain an Evasion saving throw to instantly end a physical magical binding of some sort. You can use this art only once per round.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action whenever you wish to escape chains, grapples, shackles, ropes, or even a magical spell of physical binding. You automatically wriggle free from mundane restraints and gain an Evasion saving throw to instantly end a physical magical binding of some sort. You can use this art only once per round."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/uncanny-ichor",
      "@type": "Art",
      "name": "Uncanny Ichor",
      "slug": "uncanny-ichor",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "Partial Necromancer Arts and Spells",
        "lineStart": 1789,
        "lineEnd": 1789
      },
      "rulesText": "Uncanny Ichor: Your blood is not like the blood of normal beings. Predators find it nauseating and will not bite you unless provoked. Unintelligent predators will not consider you edible. This ichor is reluctant to leave your body, and stabbing or puncture injuries can Mortally Wound you but cannot result in your death unless you are entirely pincushioned by your foes or suffer catastrophic physical damage.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "Your blood is not like the blood of normal beings. Predators find it nauseating and will not bite you unless provoked. Unintelligent predators will not consider you edible. This ichor is reluctant to leave your body, and stabbing or puncture injuries can Mortally Wound you but cannot result in your death unless you are entirely pincushioned by your foes or suffer catastrophic physical damage."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unliving-persistence",
      "@type": "Art",
      "name": "Unliving Persistence",
      "slug": "unliving-persistence",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "Partial Necromancer Arts and Spells",
        "lineStart": 1791,
        "lineEnd": 1791
      },
      "rulesText": "Unliving Persistence: Commit Effort for the day as an On Turn action to automatically stabilize when Mortally Wounded. You may use this ability to benefit others if you are able to touch them. This ability cannot save a subject that has experienced dismemberment or other extremely final deaths.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action to automatically stabilize when Mortally Wounded. You may use this ability to benefit others if you are able to touch them. This ability cannot save a subject that has experienced dismemberment or other extremely final deaths."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unobtrusive-step",
      "@type": "Art",
      "name": "Unobtrusive Step",
      "slug": "unobtrusive-step",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2178,
        "lineEnd": 2178
      },
      "rulesText": "Unobtrusive Step: You not only possess a considerable skill for disguise and obfuscation, you can become extremely hard to detect. Once per scene, you may Commit Effort for the day as an Instant action to reroll a failed Sneak skill check or skill check related to impersonating someone else.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "You not only possess a considerable skill for disguise and obfuscation, you can become extremely hard to detect. Once per scene, you may Commit Effort for the day as an Instant action to reroll a failed Sneak skill check or skill check related to impersonating someone else."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unseen-steps",
      "@type": "Art",
      "name": "Unseen Steps",
      "slug": "unseen-steps",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 631,
        "lineEnd": 631
      },
      "rulesText": "Unseen Steps: As an On Turn action, Commit Effort for the day to turn invisible for 1d6 rounds plus your level. This invisibility breaks before you attack, cast spells, or perform other vigorous or violent actions.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "As an On Turn action, Commit Effort for the day to turn invisible for 1d6 rounds plus your level. This invisibility breaks before you attack, cast spells, or perform other vigorous or violent actions."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unthinkable-thought",
      "@type": "Art",
      "name": "Unthinkable Thought",
      "slug": "unthinkable-thought",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Thought Noble Arts",
        "lineStart": 2066,
        "lineEnd": 2066
      },
      "rulesText": "Unthinkable Thought: Target a visible living creature and Commit Effort for the day as a Main Action while specifying a particular person, object, or situation that is currently ongoing in their presence. The target may make a Mental save to resist; on a failure, they simply cannot consciously acknowledge the existence of the subject or its actions unless ignoring it would obviously put their life at risk. This forced ignorance lasts for up to a scene; at its end, the target will have no memory of the subject.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Target a visible living creature and Commit Effort for the day as a Main Action while specifying a particular person, object, or situation that is currently ongoing in their presence. The target may make a Mental save to resist; on a failure, they simply cannot consciously acknowledge the existence of the subject or its actions unless ignoring it would obviously put their life at risk. This forced ignorance lasts for up to a scene; at its end, the target will have no memory of the subject."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/unworthy-rabble",
      "@type": "Art",
      "name": "Unworthy Rabble",
      "slug": "unworthy-rabble",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1050,
        "lineEnd": 1050
      },
      "rulesText": "Unworthy Rabble: Commit Effort for the day as an On Turn action. For the rest of the scene, when using your favored weapon, reroll any failed hit roll against foes with one hit die. At eighth level, this ability applies to foes with two hit dice.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action. For the rest of the scene, when using your favored weapon, reroll any failed hit roll against foes with one hit die. At eighth level, this ability applies to foes with two hit dice."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/vital-furnace",
      "@type": "Art",
      "name": "Vital Furnace",
      "slug": "vital-furnace",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Partial Warrior/Healer",
        "lineStart": 1361,
        "lineEnd": 1361
      },
      "rulesText": "Vital Furnace: Your tremendous life energy can be used to instantly regenerate any non-mortal wound you have received. Commit Effort for the day as an Instant action to negate the damage from an injury you just received that did not reduce you to zero hit points. Aside from this ability, you automatically stabilize if reduced to zero hit points and awaken ten minutes later with 1 hit point. This ability cannot undo damage you intentionally inflict on yourself via some power or magical exchange.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Your tremendous life energy can be used to instantly regenerate any non-mortal wound you have received. Commit Effort for the day as an Instant action to negate the damage from an injury you just received that did not reduce you to zero hit points. Aside from this ability, you automatically stabilize if reduced to zero hit points and awaken ten minutes later with 1 hit point. This ability cannot undo damage you intentionally inflict on yourself via some power or magical exchange."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/vowed-arts",
      "@type": "Art",
      "name": "Vowed Arts",
      "slug": "vowed-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "1.5.17.1 Vowed Arts",
        "lineStart": 2082,
        "lineEnd": 2093
      },
      "rulesText": "Vowed Effort is based on the skill they chose to represent their order’s main focus of study, whether Exert, Know, Magic, Pray, or some more esoteric skill.\n\nTheir maximum Vowed Effort is equal to this skill level plus their best attribute modifier, whatever it may be, to a minimum of one point. All Vowed automatically gain the Martial Style, Unarmed Might, and Unarmored Defense arts as part of their training.\n\nMartial Style: Regardless of class, your hit die can’t be worse than 1d6 per level. When attacking with the Punch skill, your class hit bonus can be no worse than that of an Expert of your same character level. At third level, any attack using the Punch skill counts as a magic weapon.\n\nUnarmed Might: Your unarmed attack damage increases as you gain levels, as noted on the chart. You may add your Punch skill to the damage done by these attacks as usual, but Foci such as Unarmed Combatant that replace or improve your usual Punch damage do not apply to you.\n\nUnarmored Defense: When not wearing armor or using a shield, your base Armor Class is equal to 13 plus half your character level, rounded down.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Vowed Effort is based on the skill they chose to represent their order’s main focus of study, whether Exert, Know, Magic, Pray, or some more esoteric skill.\n\nTheir maximum Vowed Effort is equal to this skill level plus their best attribute modifier, whatever it may be, to a minimum of one point. All Vowed automatically gain the Martial Style, Unarmed Might, and Unarmored Defense arts as part of their training.\n\nMartial Style: Regardless of class, your hit die can’t be worse than 1d6 per level. When attacking with the Punch skill, your class hit bonus can be no worse than that of an Expert of your same character level. At third level, any attack using the Punch skill counts as a magic weapon.\n\nUnarmed Might: Your unarmed attack damage increases as you gain levels, as noted on the chart. You may add your Punch skill to the damage done by these attacks as usual, but Foci such as Unarmed Combatant that replace or improve your usual Punch damage do not apply to you.\n\nUnarmored Defense: When not wearing armor or using a shield, your base Armor Class is equal to 13 plus half your character level, rounded down."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/war-curse",
      "@type": "Art",
      "name": "War Curse",
      "slug": "war-curse",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Curses and Blessings",
        "lineStart": 2375,
        "lineEnd": 2375
      },
      "rulesText": "War Curse: As a Main Action, curse a visible enemy. They suffer a -2 penalty to hit rolls, damage rolls, and Shock damage for the rest of the scene. If they miss an attack with a raw to-hit die roll less than the Wise’s Magic skill, they accidentally hurt themselves for normal damage. Only one war curse can be applied at a time.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "As a Main Action, curse a visible enemy. They suffer a -2 penalty to hit rolls, damage rolls, and Shock damage for the rest of the scene. If they miss an attack with a raw to-hit die roll less than the Wise’s Magic skill, they accidentally hurt themselves for normal damage. Only one war curse can be applied at a time."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/ward-allies",
      "@type": "Art",
      "name": "Ward Allies",
      "slug": "ward-allies",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "Partial High Mage Arts and Spells",
        "lineStart": 1467,
        "lineEnd": 1467
      },
      "rulesText": "Ward Allies: Commit Effort for the day as an Instant action to omit up to six allies from the effects of an area-effect spell you cast, allowing them to avoid any damage or other negative effect that would be directly produced by the spell. This does not protect them from indirect consequences, however, such as destroying the building they are standing in.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action to omit up to six allies from the effects of an area-effect spell you cast, allowing them to avoid any damage or other negative effect that would be directly produced by the spell. This does not protect them from indirect consequences, however, such as destroying the building they are standing in."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/ward-ally",
      "@type": "Art",
      "name": "Ward Ally",
      "slug": "ward-ally",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "Mageslayer Art Progression",
        "lineStart": 1702,
        "lineEnd": 1702
      },
      "rulesText": "Ward Ally: As an Instant action, Commit Effort for the scene when an ally within thirty feet is affected by a spell; you are affected by the spell in place of your ally. If you are both in the same area of effect, the spell hits you twice. Any defenses or arts you have against sorcery may be applied as usual to this transferred effect.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "As an Instant action, Commit Effort for the scene when an ally within thirty feet is affected by a spell; you are affected by the spell in place of your ally. If you are both in the same area of effect, the spell hits you twice. Any defenses or arts you have against sorcery may be applied as usual to this transferred effect."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/warform",
      "@type": "Art",
      "name": "Warform",
      "slug": "warform",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Skinshifter Arts and Form Bonus",
        "lineStart": 1954,
        "lineEnd": 1954
      },
      "rulesText": "Warform: You gain a flat +2 bonus to all melee hit rolls in this shape and can use your form hit bonus even in a humanoid body. This shape is blatantly martial in appearance, however, and cannot pass as anything harmless or wholly human.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "You gain a flat +2 bonus to all melee hit rolls in this shape and can use your form hit bonus even in a humanoid body. This shape is blatantly martial in appearance, however, and cannot pass as anything harmless or wholly human."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/weeping-wounds",
      "@type": "Art",
      "name": "Weeping Wounds",
      "slug": "weeping-wounds",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 635,
        "lineEnd": 635
      },
      "rulesText": "Weeping Wounds: Once per round, Commit Effort for the scene as an Instant action when a visible enemy takes damage. They must make a Physical save or suffer 1d6 damage per round for one round per level. They cannot heal or regenerate any hit point damage during this effect. This art does not stack.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Once per round, Commit Effort for the scene as an Instant action when a visible enemy takes damage. They must make a Physical save or suffer 1d6 damage per round for one round per level. They cannot heal or regenerate any hit point damage during this effect. This art does not stack."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/weight-of-sin",
      "@type": "Art",
      "name": "Weight of Sin",
      "slug": "weight-of-sin",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "Partial Warrior/Accursed",
        "lineStart": 633,
        "lineEnd": 633
      },
      "rulesText": "Weight of Sin: As a Main Action, Commit Effort for the day and target a visible foe. They must make a Physical save or lose their Move action for 1d6 rounds plus your level.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "As a Main Action, Commit Effort for the day and target a visible foe. They must make a Physical save or lose their Move action for 1d6 rounds plus your level."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/whirling-evasion",
      "@type": "Art",
      "name": "Whirling Evasion",
      "slug": "whirling-evasion",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1065,
        "lineEnd": 1065
      },
      "rulesText": "Whirling Evasion: Your base Armor Class becomes equal to 13 plus half your level, rounded up. This AC can be modified by small shields and your Dexterity modifier, but not by armor or large shields.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Your base Armor Class becomes equal to 13 plus half your level, rounded up. This AC can be modified by small shields and your Dexterity modifier, but not by armor or large shields."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/wisdom-of-fin-and-scale",
      "@type": "Art",
      "name": "Wisdom of Fin and Scale",
      "slug": "wisdom-of-fin-and-scale",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Skinshifter Arts and Form Bonus",
        "lineStart": 1956,
        "lineEnd": 1956
      },
      "rulesText": "Wisdom of Fin and Scale: This shape can breathe water, swim at double your usual Move rate, and is impervious to any normal climatic extreme of cold or undersea pressure. It can see up to sixty feet while underwater even in the absence of normal light.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape can breathe water, swim at double your usual Move rate, and is impervious to any normal climatic extreme of cold or undersea pressure. It can see up to sixty feet while underwater even in the absence of normal light."
        }
      ]
    },
    {
