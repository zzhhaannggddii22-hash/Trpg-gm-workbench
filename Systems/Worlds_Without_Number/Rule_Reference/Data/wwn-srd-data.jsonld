      },
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "level": 1,
      "effects": [
        {
          "sourceText": "The elementalist makes a direct appeal to a non-magical mass of earth, stone, water, flame, or air no larger than a ten-foot cube. At the end of the round, the mass will move or reshape itself within that space as the elementalist requests, maintaining its new form until the end of the scene. If its new shape is one that is stable without magical help, it can be told to remain in it after the spell is finished."
        }
      ],
      "rulesText": "The elementalist makes a direct appeal to a non-magical mass of earth, stone, water, flame, or air no larger than a ten-foot cube. At the end of the round, the mass will move or reshape itself within that space as the elementalist requests, maintaining its new form until the end of the scene. If its new shape is one that is stable without magical help, it can be told to remain in it after the spell is finished."
    },
