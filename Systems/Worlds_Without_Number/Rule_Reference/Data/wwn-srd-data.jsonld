          ]
        },
        {
          "position": 7,
          "result": "7",
          "cells": [
            "7",
            ""
          ]
        },
        {
          "position": 8,
          "result": "8",
          "cells": [
            "8",
            "Any One"
          ]
        },
        {
          "position": 9,
          "result": "9",
