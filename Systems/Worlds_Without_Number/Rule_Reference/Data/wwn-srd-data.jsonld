    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/2h",
      "@type": "WeaponTrait",
      "name": "2H",
      "slug": "2h",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "2H",
      "rulesText": "Two Handed. The weapon requires two hands to use in combat. Ranged two-handed weapons cannot be fired effectively while an enemy is within melee range."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/ap",
      "@type": "WeaponTrait",
      "name": "AP",
      "slug": "ap",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "AP",
      "rulesText": "Armor Piercing. This weapon ignores non-magical hides, armor and shields for purposes of its hit rolls."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/fx",
      "@type": "WeaponTrait",
      "name": "FX",
      "slug": "fx",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "FX",
      "rulesText": "Fixed. The weapon is too heavy and clumsy to use without a fixed position and at least five minutes to entrench it."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/l",
      "@type": "WeaponTrait",
      "name": "L",
      "slug": "l",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "L",
      "rulesText": "Long. The weapon is unusually long, allowing melee attacks to be made at targets up to 10 feet distant, even if an ally is in the way. Even so, the wielder still needs to be within five feet of a foe to count as being in melee with them for purposes of forcing Fighting Withdrawals, disrupting large ranged weapons, or similar maneuvers."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/ll",
      "@type": "WeaponTrait",
      "name": "LL",
      "slug": "ll",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "LL",
      "rulesText": "Less Lethal. Foes brought to zero hit points by this weapon can always be left alive at the wielder’s discretion."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/n",
      "@type": "WeaponTrait",
      "name": "N",
      "slug": "n",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "N",
      "rulesText": "Numerous. Five of these count as only one Readied item."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/pm",
      "@type": "WeaponTrait",
      "name": "PM",
      "slug": "pm",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "PM",
      "rulesText": "Precisely Murderous. When used for an Execution Attack, the weapon applies an additional -1 penalty to the Physical save and does double damage even if it succeeds."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/r",
      "@type": "WeaponTrait",
      "name": "R",
      "slug": "r",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "R",
      "rulesText": "Reload. The weapon takes a Move action to reload. If the user has at least Shoot-1 skill, they can reload as an On Turn action instead."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/s",
      "@type": "WeaponTrait",
      "name": "S",
      "slug": "s",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "S",
      "rulesText": "Subtle. Can be easily hidden in clothing or jewelry."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/sr",
      "@type": "WeaponTrait",
      "name": "SR",
      "slug": "sr",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "SR",
      "rulesText": "Slow Reload. It takes a Main Action to reload this weapon."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/ss",
      "@type": "WeaponTrait",
      "name": "SS",
      "slug": "ss",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "SS",
      "rulesText": "Single Shot. This weapon takes ten rounds to reload, and the reloading effort is spoiled if an enemy melees the wielder."
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/weapon-traits/t",
      "@type": "WeaponTrait",
      "name": "T",
      "slug": "t",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "3.4.3",
        "heading": "3.4.3 Weapon Traits",
        "lineStart": 3779,
        "lineEnd": 3792
      },
      "code": "T",
      "rulesText": "Throwable. While the weapon can be used in melee, it may be thrown out to the listed range as well, albeit it does no Shock in that case. Throwing a weapon while in melee applies a -4 penalty to the hit roll."
    },
