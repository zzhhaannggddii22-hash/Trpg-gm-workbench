        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/beast-ward",
      "@type": "Art",
      "name": "Beast Ward",
      "slug": "beast-ward",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Other Beastmaster Arts",
        "lineStart": 814,
        "lineEnd": 814
      },
      "rulesText": "Beast Ward: Commit Effort as an On Turn action. So long as the Effort remains Committed, the Beastmaster will not be attacked by unintelligent beasts unless the beast is commanded to do so by its master, the beast is starving, or the Beastmaster or their allies performs some hostile act against it. Once the ward ends or is broken, it cannot be re-established in the same scene. Magical beasts and those trained specifically as guardians of an area get a Mental save to resist this power.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action. So long as the Effort remains Committed, the Beastmaster will not be attacked by unintelligent beasts unless the beast is commanded to do so by its master, the beast is starving, or the Beastmaster or their allies performs some hostile act against it. Once the ward ends or is broken, it cannot be re-established in the same scene. Magical beasts and those trained specifically as guardians of an area get a Mental save to resist this power."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/beastmaster-arts",
      "@type": "Art",
      "name": "Beastmaster Arts",
      "slug": "beastmaster-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "1.5.4.1 Beastmaster Arts",
        "lineStart": 806,
        "lineEnd": 811
      },
      "rulesText": "Beastmaster Effort is calculated with Survive, and is equal to the PC’s Survive skill level plus the higher of their Wisdom or Charisma modifiers, to a minimum of one point. All Beastmasters start play with the Bind Companion art and one more of their choosing. They learn additional arts as they gain experience. Unlike some Mage traditions, Beastmasters can use their arts normally while armored.\n\nBind Companion: With a day’s work in a location you can find and bind a suitable animal companion. If looking for a particular type of companion, it must be found in the area and may require a Wis/Survive skill check at a difficulty of 10 or more if it’s a particularly rare creature. If you encounter a suitable animal on an adventure, you may bind it as a Main Action, with the creature allowed a Mental saving throw to resist and become impervious to your powers. You may release a companion as a Main Action if you no longer wish its service or want to bind a different beast.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Beastmaster Effort is calculated with Survive, and is equal to the PC’s Survive skill level plus the higher of their Wisdom or Charisma modifiers, to a minimum of one point. All Beastmasters start play with the Bind Companion art and one more of their choosing. They learn additional arts as they gain experience. Unlike some Mage traditions, Beastmasters can use their arts normally while armored.\n\nBind Companion: With a day’s work in a location you can find and bind a suitable animal companion. If looking for a particular type of companion, it must be found in the area and may require a Wis/Survive skill check at a difficulty of 10 or more if it’s a particularly rare creature. If you encounter a suitable animal on an adventure, you may bind it as a Main Action, with the creature allowed a Mental saving throw to resist and become impervious to your powers. You may release a companion as a Main Action if you no longer wish its service or want to bind a different beast."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/beckoned-deluge",
      "@type": "Art",
      "name": "Beckoned Deluge",
      "slug": "beckoned-deluge",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Other Elementalist Arts",
        "lineStart": 1091,
        "lineEnd": 1091
      },
      "rulesText": "Beckoned Deluge: Commit Effort for the scene as a Main Action to conjure a considerable amount of water at a visible point within fifty feet per caster level. This water is sufficient to drench one 10-foot cube of matter per character level, making non-magical bowstrings useless, extinguishing flames, and inflicting 1d6 damage per caster level on fiery supernatural creatures. This water persists indefinitely after its conjuration and is sufficient to hydrate ten people per caster level.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Main Action to conjure a considerable amount of water at a visible point within fifty feet per caster level. This water is sufficient to drench one 10-foot cube of matter per character level, making non-magical bowstrings useless, extinguishing flames, and inflicting 1d6 damage per caster level on fiery supernatural creatures. This water persists indefinitely after its conjuration and is sufficient to hydrate ten people per caster level."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/bewitching-distraction",
      "@type": "Art",
      "name": "Bewitching Distraction",
      "slug": "bewitching-distraction",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "1.5.2.1 Accursed Arts",
        "lineStart": 556,
        "lineEnd": 556
      },
      "rulesText": "Bewitching Distraction: Commit Effort for the day as a Main Action when talking to an intelligent target when not in combat. They must make a Mental save or become dazed, oblivious to their surroundings and forgetting you and all else that happened in that scene. Danger ends the daze but not the forgetting.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action when talking to an intelligent target when not in combat. They must make a Mental save or become dazed, oblivious to their surroundings and forgetting you and all else that happened in that scene. Danger ends the daze but not the forgetting."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/bind-companion",
      "@type": "Art",
      "name": "Bind Companion",
      "slug": "bind-companion",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "1.5.4.1 Beastmaster Arts",
        "lineStart": 810,
        "lineEnd": 810
      },
      "rulesText": "Bind Companion: With a day’s work in a location you can find and bind a suitable animal companion. If looking for a particular type of companion, it must be found in the area and may require a Wis/Survive skill check at a difficulty of 10 or more if it’s a particularly rare creature. If you encounter a suitable animal on an adventure, you may bind it as a Main Action, with the creature allowed a Mental saving throw to resist and become impervious to your powers. You may release a companion as a Main Action if you no longer wish its service or want to bind a different beast.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "With a day’s work in a location you can find and bind a suitable animal companion. If looking for a particular type of companion, it must be found in the area and may require a Wis/Survive skill check at a difficulty of 10 or more if it’s a particularly rare creature. If you encounter a suitable animal on an adventure, you may bind it as a Main Action, with the creature allowed a Mental saving throw to resist and become impervious to your powers. You may release a companion as a Main Action if you no longer wish its service or want to bind a different beast."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/block-memory",
      "@type": "Art",
      "name": "Block Memory",
      "slug": "block-memory",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Other Thought Noble Arts",
        "lineStart": 1978,
        "lineEnd": 1978
      },
      "rulesText": "Block Memory: Target a visible living creature and Commit Effort for the day as a Main Action while specifying a particular event or situation that didn’t extend longer than a scene. The target gets a Mental saving throw; on a failure, they simply cannot remember the event and will construct a plausible false memory to paper over the gap. The memory can be restored by use of this power once more or a magical dispelling ability, but detecting the alteration is difficult; any power that detects enchantments on a target does so with a +2 difficulty penalty to any skill check made to discern the ban.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Target a visible living creature and Commit Effort for the day as a Main Action while specifying a particular event or situation that didn’t extend longer than a scene. The target gets a Mental saving throw; on a failure, they simply cannot remember the event and will construct a plausible false memory to paper over the gap. The memory can be restored by use of this power once more or a magical dispelling ability, but detecting the alteration is difficult; any power that detects enchantments on a target does so with a +2 difficulty penalty to any skill check made to discern the ban."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/blood-for-blood",
      "@type": "Art",
      "name": "Blood for Blood",
      "slug": "blood-for-blood",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Other Duelist Arts",
        "lineStart": 979,
        "lineEnd": 979
      },
      "rulesText": "Blood for Blood: Commit Effort for the scene as an Instant action when an enemy hits you with a physical attack. If you attack that enemy with your favored weapon before the end of the next round, the first blow hits automatically and can do no less damage than was done to you, up to the weapon’s maximum.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an Instant action when an enemy hits you with a physical attack. If you attack that enemy with your favored weapon before the end of the next round, the first blow hits automatically and can do no less damage than was done to you, up to the weapon’s maximum."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/blood-priest-arts",
      "@type": "Art",
      "name": "Blood Priest Arts",
      "slug": "blood-priest-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "1.5.5.1 Blood Priest Arts",
        "lineStart": 861,
        "lineEnd": 891
      },
      "rulesText": "Blood Priest Effort is calculated with Pray, with their total maximum Effort being equal to their Pray skill plus the higher of their Wisdom or Charisma modifiers, to a minimum of one point.\n\nAt first level, the Blood Priest may choose two of the following miracles to master, and gain more as they advance in levels. Once chosen, a miracle pick is permanent and cannot be changed later. Miracles are not hindered by the wearing of armor and require no gestures or free hand to employ, though usually a prayer must be vocalized as part of the action.\n\nA Thousand Tongues: Commit Effort as an On Turn action; while it remains Committed, you can speak with and understand any sentient creature with a language of their own. To any listener, it will seem as if you are perfectly fluent in their own language, even as you speak in your own native tongue. This ability does not allow you to read or write unknown languages.\n\nArmor of God: Commit Effort as an On Turn action. While the Effort remains Committed, you have a natural Armor Class of 15 plus half your level, rounded down. This AC can be modified by shields or your Dexterity modifier, but not by other worn armor.\n\nDivine Guidance: Commit Effort for the day as a Main Action and meditate upon a choice or potential action before you. The GM will tell you whether the likely outcome of that choice is weal, woe, a mix of both, or nothing significant, using their own best estimation. This insight cannot perceive likely outcomes more than an hour or so into the future.\n\nFear No Flame: Commit Effort for the day as an On Turn action while nominating a visible target. For the rest of the scene, they are immune to non-magical flame, smoke, or explosive damage, and decrease any sources of such magical damage they take by five points per level of Pray you have.\n\nGod Wills It: Commit Effort for the day as an Instant action and loudly call down your god’s blessing on your comrades. For the rest of the scene, up to six allies per character level in earshot gain an effective Morale of 12 and a +1 bonus to hit and damage rolls, including any Shock that may be inflicted. At fifth level this becomes a +2 bonus, and at tenth level it becomes a +3 bonus.\n\nMerciful Healing: Commit Effort for the day as a Main Action and touch a target within melee range. The target receives 1d6+2 points of magical healing. If done in combat or used to revive a Mortally Wounded subject, the rushed haste of the healing adds 1 System\n\n|Level|Hit Dice|Attack<br>Bonus|Focus Picks|\n|---|---|---|---|\n|1|1d6|+0|1 Expert<br>+1 Any|\n|2|2d6|+1|+1 Any|\n|3|3d6|+1||\n|4|4d6|+2||\n|5|5d6|+2|+1 Any|\n|6|6d6|+3||\n|7|7d6|+3|+1 Any|\n|8|8d6|+4||\n|9|9d6|+4||\n|10|10d6|+5|+1 Any|",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Blood Priest Effort is calculated with Pray, with their total maximum Effort being equal to their Pray skill plus the higher of their Wisdom or Charisma modifiers, to a minimum of one point.\n\nAt first level, the Blood Priest may choose two of the following miracles to master, and gain more as they advance in levels. Once chosen, a miracle pick is permanent and cannot be changed later. Miracles are not hindered by the wearing of armor and require no gestures or free hand to employ, though usually a prayer must be vocalized as part of the action.\n\nA Thousand Tongues: Commit Effort as an On Turn action; while it remains Committed, you can speak with and understand any sentient creature with a language of their own. To any listener, it will seem as if you are perfectly fluent in their own language, even as you speak in your own native tongue. This ability does not allow you to read or write unknown languages.\n\nArmor of God: Commit Effort as an On Turn action. While the Effort remains Committed, you have a natural Armor Class of 15 plus half your level, rounded down. This AC can be modified by shields or your Dexterity modifier, but not by other worn armor.\n\nDivine Guidance: Commit Effort for the day as a Main Action and meditate upon a choice or potential action before you. The GM will tell you whether the likely outcome of that choice is weal, woe, a mix of both, or nothing significant, using their own best estimation. This insight cannot perceive likely outcomes more than an hour or so into the future.\n\nFear No Flame: Commit Effort for the day as an On Turn action while nominating a visible target. For the rest of the scene, they are immune to non-magical flame, smoke, or explosive damage, and decrease any sources of such magical damage they take by five points per level of Pray you have.\n\nGod Wills It: Commit Effort for the day as an Instant action and loudly call down your god’s blessing on your comrades. For the rest of the scene, up to six allies per character level in earshot gain an effective Morale of 12 and a +1 bonus to hit and damage rolls, including any Shock that may be inflicted. At fifth level this becomes a +2 bonus, and at tenth level it becomes a +3 bonus.\n\nMerciful Healing: Commit Effort for the day as a Main Action and touch a target within melee range. The target receives 1d6+2 points of magical healing. If done in combat or used to revive a Mortally Wounded subject, the rushed haste of the healing adds 1 System\n\n|Level|Hit Dice|Attack<br>Bonus|Focus Picks|\n|---|---|---|---|\n|1|1d6|+0|1 Expert<br>+1 Any|\n|2|2d6|+1|+1 Any|\n|3|3d6|+1||\n|4|4d6|+2||\n|5|5d6|+2|+1 Any|\n|6|6d6|+3||\n|7|7d6|+3|+1 Any|\n|8|8d6|+4||\n|9|9d6|+4||\n|10|10d6|+5|+1 Any|"
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/bonetalker",
      "@type": "Art",
      "name": "Bonetalker",
      "slug": "bonetalker",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "1.5.14.1 Necromancer Arts",
        "lineStart": 1724,
        "lineEnd": 1724
      },
      "rulesText": "Bonetalker: You can see and communicate with any undead creature, regardless of a shared language or the creature’s natural state of invisibility. By Committing Effort for the scene you can sense the surface thoughts of any visible undead, including an impression of any commands or behavior it has been ordered to carry out. Unintelligent undead will not attack you or your companions unless specifically compelled to do so by a command or a master. Even intelligent undead will generally pause at least for an initial parley before attacking.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "You can see and communicate with any undead creature, regardless of a shared language or the creature’s natural state of invisibility. By Committing Effort for the scene you can sense the surface thoughts of any visible undead, including an impression of any commands or behavior it has been ordered to carry out. Unintelligent undead will not attack you or your companions unless specifically compelled to do so by a command or a master. Even intelligent undead will generally pause at least for an initial parley before attacking."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/brutal-counter",
      "@type": "Art",
      "name": "Brutal Counter",
      "slug": "brutal-counter",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Other Vowed Arts",
        "lineStart": 2096,
        "lineEnd": 2096
      },
      "rulesText": "Brutal Counter: Commit Effort for the scene as an Instant action after resolving an enemy melee attack against you, whether it hits or misses. You may make a free physical attack against your assailant, using either a normal attack or some other offensive ability that takes no more than one Main Action to execute. You cannot use this art more than once per any given attack, but you may use it while performing a Total Defense.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an Instant action after resolving an enemy melee attack against you, whether it hits or misses. You may make a free physical attack against your assailant, using either a normal attack or some other offensive ability that takes no more than one Main Action to execute. You cannot use this art more than once per any given attack, but you may use it while performing a Total Defense."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/burst-of-speed",
      "@type": "Art",
      "name": "Burst of Speed",
      "slug": "burst-of-speed",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Other Duelist Arts",
        "lineStart": 981,
        "lineEnd": 981
      },
      "rulesText": "Burst of Speed: Commit Effort for the day as an On Turn action. You may move your full normal movement rate as an On Turn action. This art can be used only once per round.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action. You may move your full normal movement rate as an On Turn action. This art can be used only once per round."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/change-form",
      "@type": "Art",
      "name": "Change Form",
      "slug": "change-form",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "1.5.15.1 Skinshifter Arts",
        "lineStart": 1866,
        "lineEnd": 1866
      },
      "rulesText": "Change Form: Commit Effort for the day as a Main Action to transform into an available Alternate form. This shift persists until you die, shift to a new form, or end the transformation as an On Turn action. Your hit points, System Strain, and other scores remain the same in any new form, but in a non-humanoid form your class’ base attack bonus can be no worse than the one listed on the table. If your shape is quadrupedal, its Move is 10’ faster than your base.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action to transform into an available Alternate form. This shift persists until you die, shift to a new form, or end the transformation as an On Turn action. Your hit points, System Strain, and other scores remain the same in any new form, but in a non-humanoid form your class’ base attack bonus can be no worse than the one listed on the table. If your shape is quadrupedal, its Move is 10’ faster than your base."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/code-duello",
      "@type": "Art",
      "name": "Code Duello",
      "slug": "code-duello",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Other Duelist Arts",
        "lineStart": 983,
        "lineEnd": 983
      },
      "rulesText": "Code Duello: Commit Effort for the day as an On Turn action when engaged with a single foe. So long as no other combatant attacks either your target or you, and you attack no one but your target, you gain a +4 bonus to your Armor Class and can roll your hit rolls twice, taking the better result. Once the Code Duello has been disrupted or ended, it cannot be invoked again during that scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action when engaged with a single foe. So long as no other combatant attacks either your target or you, and you attack no one but your target, you gain a +4 bonus to your Armor Class and can roll your hit rolls twice, taking the better result. Once the Code Duello has been disrupted or ended, it cannot be invoked again during that scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/cold-flesh",
      "@type": "Art",
      "name": "Cold Flesh",
      "slug": "cold-flesh",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "1.5.14.1 Necromancer Arts",
        "lineStart": 1726,
        "lineEnd": 1726
      },
      "rulesText": "Cold Flesh: You no longer require sleep and feel pain only in an abstract sense. You can suffer no more than 2 points of damage from any given instance of Shock and you have a natural Armor Class equal to 12 plus half your level, rounded down.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "You no longer require sleep and feel pain only in an abstract sense. You can suffer no more than 2 points of damage from any given instance of Shock and you have a natural Armor Class equal to 12 plus half your level, rounded down."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/compel-truth",
      "@type": "Art",
      "name": "Compel Truth",
      "slug": "compel-truth",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Divination Arts",
        "lineStart": 2355,
        "lineEnd": 2355
      },
      "rulesText": "Compel Truth: The diviner compels a person to drink a particular brew, participate in a specific ritual, or otherwise undergo a scenelong ordeal. Afterwards, the diviner may ask the target a single question and the GM secretly rolls a Cha/Magic skill check against a difficulty of the target’s Morale+1, or level+6 for PCs. On a success, the subject must answer the question truthfully and fully. On a failure, they may give any answer they wish. The same or substantially same question may not be asked twice with this art.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "The diviner compels a person to drink a particular brew, participate in a specific ritual, or otherwise undergo a scenelong ordeal. Afterwards, the diviner may ask the target a single question and the GM secretly rolls a Cha/Magic skill check against a difficulty of the target’s Morale+1, or level+6 for PCs. On a success, the subject must answer the question truthfully and fully. On a failure, they may give any answer they wish. The same or substantially same question may not be asked twice with this art."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/compelling-shriek",
      "@type": "Art",
      "name": "Compelling Shriek",
      "slug": "compelling-shriek",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "1.5.2.1 Accursed Arts",
        "lineStart": 558,
        "lineEnd": 558
      },
      "rulesText": "Compelling Shriek: Once per scene, Commit Effort for the day as a Main Action and shout a command of no more than seven words. Chosen targets who hear and understand must make a Mental save or perform that action for one round, provided it is not totally contrary to their character.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Once per scene, Commit Effort for the day as a Main Action and shout a command of no more than seven words. Chosen targets who hear and understand must make a Mental save or perform that action for one round, provided it is not totally contrary to their character."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/consume-life-energy",
      "@type": "Art",
      "name": "Consume Life Energy",
      "slug": "consume-life-energy",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "1.5.14.1 Necromancer Arts",
        "lineStart": 1728,
        "lineEnd": 1728
      },
      "rulesText": "Consume Life Energy: By making a Punch attack or using a melee weapon you have spent at least an hour properly consecrating, you can absorb a portion of the damage you inflict on others as healing to yourself. For each successful attack you make with such implements, you heal 1d6 damage, up to a maximum of the damage done by the attack. You cannot drain more life than the target has remaining hit points.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "By making a Punch attack or using a melee weapon you have spent at least an hour properly consecrating, you can absorb a portion of the damage you inflict on others as healing to yourself. For each successful attack you make with such implements, you heal 1d6 damage, up to a maximum of the damage done by the attack. You cannot drain more life than the target has remaining hit points."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/counter-magic",
      "@type": "Art",
      "name": "Counter Magic",
      "slug": "counter-magic",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "1.5.10.1 High Mage Arts",
        "lineStart": 1398,
        "lineEnd": 1398
      },
      "rulesText": "Counter Magic: Commit Effort for the day as an Instant action when a visible enemy mage casts a spell. Both of you make opposed Int/Magic or Cha/Magic skill checks; if you win, their spell fizzles and is wasted. This art only works on actual spellcasters and not creatures that merely activate magical powers. You can use this art no more than once per round.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action when a visible enemy mage casts a spell. Both of you make opposed Int/Magic or Cha/Magic skill checks; if you win, their spell fizzles and is wasted. This art only works on actual spellcasters and not creatures that merely activate magical powers. You can use this art no more than once per round."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/crushing-superiority",
      "@type": "Art",
      "name": "Crushing Superiority",
      "slug": "crushing-superiority",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1030,
        "lineEnd": 1030
      },
      "rulesText": "Crushing Superiority: Your favored weapon gains the Less Lethal quality if it doesn’t already have it. Commit Effort for the scene as an Instant action when you hit a target; they must immediately make an Instinct check. This ability can be used only once per scene on any given target.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Your favored weapon gains the Less Lethal quality if it doesn’t already have it. Commit Effort for the scene as an Instant action when you hit a target; they must immediately make an Instinct check. This ability can be used only once per scene on any given target."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/cursed-tune",
      "@type": "Art",
      "name": "Cursed Tune",
      "slug": "cursed-tune",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "1.5.3.1 Bard Arts",
        "lineStart": 659,
        "lineEnd": 659
      },
      "rulesText": "Cursed Tune: Commit Effort for the scene as a Main Action while targeting an intelligent creature. Your imprecations cause them to falter, inflicting a -1 penalty to their hit, damage, and saving throw rolls for one round per level. At 4th level this penalty becomes -2, and at 9th it becomes -3.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Main Action while targeting an intelligent creature. Your imprecations cause them to falter, inflicting a -1 penalty to their hit, damage, and saving throw rolls for one round per level. At 4th level this penalty becomes -2, and at 9th it becomes -3."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/dauntless-step",
      "@type": "Art",
      "name": "Dauntless Step",
      "slug": "dauntless-step",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1032,
        "lineEnd": 1032
      },
      "rulesText": "Dauntless Step: Commit Effort for the scene as an On Turn action. The Move actions you make for the rest of the round can cross vertical surfaces or difficult terrain at your full normal movement rate, provided you end the round standing upright on a surface that can bear your weight.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action. The Move actions you make for the rest of the round can cross vertical surfaces or difficult terrain at your full normal movement rate, provided you end the round standing upright on a surface that can bear your weight."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/deft-fingers",
      "@type": "Art",
      "name": "Deft Fingers",
      "slug": "deft-fingers",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "1.5.3.1 Bard Arts",
        "lineStart": 661,
        "lineEnd": 661
      },
      "rulesText": "Deft Fingers: You’re accustomed to juggling your belongings while holding an instrument. Your maximum Readied item count increases by two.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "You’re accustomed to juggling your belongings while holding an instrument. Your maximum Readied item count increases by two."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/deliver-oracle",
      "@type": "Art",
      "name": "Deliver Oracle",
      "slug": "deliver-oracle",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Divination Arts",
        "lineStart": 2357,
        "lineEnd": 2357
      },
      "rulesText": "Deliver Oracle: A petitioner asks about the outcome of a particular course of action. The diviner then spends a day in various rituals, seeking an oracular answer. At the end, the GM makes a secret Wis/ Magic skill check. If the skill check beats difficulty 8, an oracular sentence with some truth in it is produced. If the skill check beats difficulty 12, a direct and obvious oracle is produced. If the skill check is 7 or less, a hopelessly ambiguous oracle is produced, and if the dice roll a natural 2 an intentionally misleading oracle is delivered. Oracles are usually delivered as metaphors, poetry, or visions. The GM should ensure that some element of a true oracle actually does come to pass.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "A petitioner asks about the outcome of a particular course of action. The diviner then spends a day in various rituals, seeking an oracular answer. At the end, the GM makes a secret Wis/ Magic skill check. If the skill check beats difficulty 8, an oracular sentence with some truth in it is produced. If the skill check beats difficulty 12, a direct and obvious oracle is produced. If the skill check is 7 or less, a hopelessly ambiguous oracle is produced, and if the dice roll a natural 2 an intentionally misleading oracle is delivered. Oracles are usually delivered as metaphors, poetry, or visions. The GM should ensure that some element of a true oracle actually does come to pass."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/devil-s-bargain",
      "@type": "Art",
      "name": "Devil’s Bargain",
      "slug": "devil-s-bargain",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "1.5.2.1 Accursed Arts",
        "lineStart": 560,
        "lineEnd": 560
      },
      "rulesText": "Devil’s Bargain: As a Main Action, consecrate a deal you’ve made with an uncoerced person. If they violate the deal or its spirit, you know instantly and may inflict 1d6 damage per level on them if desired.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "As a Main Action, consecrate a deal you’ve made with an uncoerced person. If they violate the deal or its spirit, you know instantly and may inflict 1d6 damage per level on them if desired."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/dire-pact",
      "@type": "Art",
      "name": "Dire Pact",
      "slug": "dire-pact",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.2.1",
        "heading": "1.5.2.1 Accursed Arts",
        "lineStart": 562,
        "lineEnd": 562
      },
      "rulesText": "Dire Pact: Foes suffer a penalty equal to your Magic skill on all saves versus your Accursed arts. If they succeed, however, you gain one System Strain.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/accursed"
      },
      "traditionName": "accursed",
      "effects": [
        {
          "sourceText": "Foes suffer a penalty equal to your Magic skill on all saves versus your Accursed arts. If they succeed, however, you gain one System Strain."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/dispel-enchantment",
      "@type": "Art",
      "name": "Dispel Enchantment",
      "slug": "dispel-enchantment",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "1.5.13.1 Mageslayer Arts",
        "lineStart": 1639,
        "lineEnd": 1639
      },
      "rulesText": "Dispel Enchantment: As a Main Action, touch an ally and Commit Effort for the day. Your touch acts as an Extirpate Arcana spell. This art can only be applied to creatures, not objects, and can be applied to yourself or a given target only once per day.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "As a Main Action, touch an ally and Commit Effort for the day. Your touch acts as an Extirpate Arcana spell. This art can only be applied to creatures, not objects, and can be applied to yourself or a given target only once per day."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/disrupt-sorcery",
      "@type": "Art",
      "name": "Disrupt Sorcery",
      "slug": "disrupt-sorcery",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "1.5.13.1 Mageslayer Arts",
        "lineStart": 1641,
        "lineEnd": 1641
      },
      "rulesText": "Disrupt Sorcery: As an On Turn action, Commit Effort for the scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "As an On Turn action, Commit Effort for the scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/divine-guidance",
      "@type": "Art",
      "name": "Divine Guidance",
      "slug": "divine-guidance",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "1.5.5.1 Blood Priest Arts",
        "lineStart": 871,
        "lineEnd": 871
      },
      "rulesText": "Divine Guidance: Commit Effort for the day as a Main Action and meditate upon a choice or potential action before you. The GM will tell you whether the likely outcome of that choice is weal, woe, a mix of both, or nothing significant, using their own best estimation. This insight cannot perceive likely outcomes more than an hour or so into the future.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action and meditate upon a choice or potential action before you. The GM will tell you whether the likely outcome of that choice is weal, woe, a mix of both, or nothing significant, using their own best estimation. This insight cannot perceive likely outcomes more than an hour or so into the future."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/dodge-doom",
      "@type": "Art",
      "name": "Dodge Doom",
      "slug": "dodge-doom",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1034,
        "lineEnd": 1034
      },
      "rulesText": "Dodge Doom: Commit Effort for the day as an Instant action when caught in some explosion or other burst effect. You take half damage, or no damage if the effect allows a save and you succeed at it. You can move yourself up to ten feet away from your original location, provided the new location is behind cover or away from the blast’s point of origin.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action when caught in some explosion or other burst effect. You take half damage, or no damage if the effect allows a save and you succeed at it. You can move yourself up to ten feet away from your original location, provided the new location is behind cover or away from the blast’s point of origin."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/dread-awe",
      "@type": "Art",
      "name": "Dread Awe",
      "slug": "dread-awe",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "General Arts",
        "lineStart": 2277,
        "lineEnd": 2277
      },
      "rulesText": "Dread Awe: Your kind are figures of fear and mistrust. Gain a +1 bonus on all skill checks related to intimidation or threat. You can spend a Main Action cursing your foes in battle; those who hear suffer a -1 penalty to their next Morale check. You can do this only once per scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "Your kind are figures of fear and mistrust. Gain a +1 bonus on all skill checks related to intimidation or threat. You can spend a Main Action cursing your foes in battle; those who hear suffer a -1 penalty to their next Morale check. You can do this only once per scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/duelist-arts",
      "@type": "Art",
      "name": "Duelist Arts",
      "slug": "duelist-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "1.5.6.1 Duelist Arts",
        "lineStart": 969,
        "lineEnd": 976
      },
      "rulesText": "Duelist Effort is based on Stab, and is equal to the PC’s Stab skill plus the highest of their Dexterity or Intelligence modifiers, to a minimum of one point. All Duelists begin with the Favored Weapon art and one more of their choice. Additional arts are learned as the PC advances in experience.\n\nThe arts of the Duelist require agility and free motion. The Duelist cannot benefit from any art of this class while wearing medium or heavy armor or carrying a large shield. Dual-wielding is practiced by some Duelists, but most prefer the defensive advantages of a small offhand shield.\n\nFavored Weapon: Choose one specific type of non-unarmed melee weapon. You begin play with such a weapon, and when using this type you may use the Favored Weapon attack bonus column on the Duelist table to determine your base hit bonus, unless it’s already better for some other reason. If your second partial class is Partial Warrior, your class’ base hit bonus with the weapon is instead equal to your level. You cannot apply this or other Duelist arts to thrown weapons.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Duelist Effort is based on Stab, and is equal to the PC’s Stab skill plus the highest of their Dexterity or Intelligence modifiers, to a minimum of one point. All Duelists begin with the Favored Weapon art and one more of their choice. Additional arts are learned as the PC advances in experience.\n\nThe arts of the Duelist require agility and free motion. The Duelist cannot benefit from any art of this class while wearing medium or heavy armor or carrying a large shield. Dual-wielding is practiced by some Duelists, but most prefer the defensive advantages of a small offhand shield.\n\nFavored Weapon: Choose one specific type of non-unarmed melee weapon. You begin play with such a weapon, and when using this type you may use the Favored Weapon attack bonus column on the Duelist table to determine your base hit bonus, unless it’s already better for some other reason. If your second partial class is Partial Warrior, your class’ base hit bonus with the weapon is instead equal to your level. You cannot apply this or other Duelist arts to thrown weapons."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/earthsight",
      "@type": "Art",
      "name": "Earthsight",
      "slug": "earthsight",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Other Elementalist Arts",
        "lineStart": 1093,
        "lineEnd": 1093
      },
      "rulesText": "Earthsight: Commit Effort for the scene as an On Turn action. For the rest of the scene, you can see the outlines of solid objects even in perfect darkness, and can peer through a number of feet of earth or stone equal to your character level.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action. For the rest of the scene, you can see the outlines of solid objects even in perfect darkness, and can peer through a number of feet of earth or stone equal to your character level."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/elemental-blast",
      "@type": "Art",
      "name": "Elemental Blast",
      "slug": "elemental-blast",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Other Elementalist Arts",
        "lineStart": 1095,
        "lineEnd": 1095
      },
      "rulesText": "Elemental Blast: Commit Effort for the scene as a Main Action to hurl a blast of some elemental force at a visible target within fifty feet per character level. The attack is made with Magic as the combat skill, Int, Cha, or Dex as the attribute, and a bonus to hit equal to your character level. It is not hindered by melee foes. On a hit, the attack does 1d6 damage plus your character level and attribute",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Main Action to hurl a blast of some elemental force at a visible target within fifty feet per character level. The attack is made with Magic as the combat skill, Int, Cha, or Dex as the attribute, and a bonus to hit equal to your character level. It is not hindered by melee foes. On a hit, the attack does 1d6 damage plus your character level and attribute"
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/elemental-resilience",
      "@type": "Art",
      "name": "Elemental Resilience",
      "slug": "elemental-resilience",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "1.5.7.1 Elementalist Arts",
        "lineStart": 1085,
        "lineEnd": 1085
      },
      "rulesText": "Elemental Resilience: You are unharmed by mundane extremes of cold or by heat less than that of a furnace. You suffer only half damage from magical or extremely intense flame or frost attacks.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "You are unharmed by mundane extremes of cold or by heat less than that of a furnace. You suffer only half damage from magical or extremely intense flame or frost attacks."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/elemental-sparks",
      "@type": "Art",
      "name": "Elemental Sparks",
      "slug": "elemental-sparks",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "1.5.7.1 Elementalist Arts",
        "lineStart": 1087,
        "lineEnd": 1087
      },
      "rulesText": "Elemental Sparks: You can conjure petty amounts of flame, water, ice, stone, or wind, sufficient to do small tricks, chill drinks, light candles, or do other minor things. Conjured substances last no longer than a scene, and conjured water cannot lastingly quench thirst. This art cannot actually be useful in solving a problem or overcoming a challenge more than once per game session.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "You can conjure petty amounts of flame, water, ice, stone, or wind, sufficient to do small tricks, chill drinks, light candles, or do other minor things. Conjured substances last no longer than a scene, and conjured water cannot lastingly quench thirst. This art cannot actually be useful in solving a problem or overcoming a challenge more than once per game session."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/elementalist-arts",
      "@type": "Art",
      "name": "Elementalist Arts",
      "slug": "elementalist-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "1.5.7.1 Elementalist Arts",
        "lineStart": 1081,
        "lineEnd": 1088
      },
      "rulesText": "Elementalist Effort is calculated as usual, with each PC’s maximum being equal to one plus their Magic skill level plus the better of their Intelligence or Charisma modifiers. Partial Elementalists have a score one point lower than this, albeit not less than one.\n\nElemental Resilience: You are unharmed by mundane extremes of cold or by heat less than that of a furnace. You suffer only half damage from magical or extremely intense flame or frost attacks.\n\nElemental Sparks: You can conjure petty amounts of flame, water, ice, stone, or wind, sufficient to do small tricks, chill drinks, light candles, or do other minor things. Conjured substances last no longer than a scene, and conjured water cannot lastingly quench thirst. This art cannot actually be useful in solving a problem or overcoming a challenge more than once per game session.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Elementalist Effort is calculated as usual, with each PC’s maximum being equal to one plus their Magic skill level plus the better of their Intelligence or Charisma modifiers. Partial Elementalists have a score one point lower than this, albeit not less than one.\n\nElemental Resilience: You are unharmed by mundane extremes of cold or by heat less than that of a furnace. You suffer only half damage from magical or extremely intense flame or frost attacks.\n\nElemental Sparks: You can conjure petty amounts of flame, water, ice, stone, or wind, sufficient to do small tricks, chill drinks, light candles, or do other minor things. Conjured substances last no longer than a scene, and conjured water cannot lastingly quench thirst. This art cannot actually be useful in solving a problem or overcoming a challenge more than once per game session."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/elicitation-of-truth",
      "@type": "Art",
      "name": "Elicitation of Truth",
      "slug": "elicitation-of-truth",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Other Thought Noble Arts",
        "lineStart": 1980,
        "lineEnd": 1980
      },
      "rulesText": "Elicitation of Truth: This art can only be taken by those who have mastered Surface Apprehension. It can only be used on a helpless or cooperative target; the Thought Noble may Commit Effort for the day and ask the target a question that takes no more than two sentences to ask. If the target fails a Mental saving throw, they must fully and completely answer the question. They need not exercise any personal judgment or speculation, but they must answer directly and without conscious deception.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "This art can only be taken by those who have mastered Surface Apprehension. It can only be used on a helpless or cooperative target; the Thought Noble may Commit Effort for the day and ask the target a question that takes no more than two sentences to ask. If the target fails a Mental saving throw, they must fully and completely answer the question. They need not exercise any personal judgment or speculation, but they must answer directly and without conscious deception."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/elite-ties",
      "@type": "Art",
      "name": "Elite Ties",
      "slug": "elite-ties",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "General Arts",
        "lineStart": 2279,
        "lineEnd": 2279
      },
      "rulesText": "Elite Ties: You have ties with figures of societal importance. You can get audiences with them with minimal effort. Once per game session, get a favor from them that would not particularly inconvenience them to grant.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "You have ties with figures of societal importance. You can get audiences with them with minimal effort. Once per game session, get a favor from them that would not particularly inconvenience them to grant."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/empowered-healer",
      "@type": "Art",
      "name": "Empowered Healer",
      "slug": "empowered-healer",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Other Healer Arts",
        "lineStart": 1292,
        "lineEnd": 1292
      },
      "rulesText": "Empowered Healer: Your Healing Touch becomes more powerful, adding your level to any healing.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Your Healing Touch becomes more powerful, adding your level to any healing."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/empowered-sorcery",
      "@type": "Art",
      "name": "Empowered Sorcery",
      "slug": "empowered-sorcery",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "1.5.10.1 High Mage Arts",
        "lineStart": 1400,
        "lineEnd": 1400
      },
      "rulesText": "Empowered Sorcery: Commit Effort for the day as an Instant action to re-roll any variable die roll associated with a spell’s effects, such as a damage roll; take the roll you prefer.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action to re-roll any variable die roll associated with a spell’s effects, such as a damage roll; take the roll you prefer."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/entangle-incantation",
      "@type": "Art",
      "name": "Entangle Incantation",
      "slug": "entangle-incantation",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "1.5.3.1 Bard Arts",
        "lineStart": 663,
        "lineEnd": 663
      },
      "rulesText": "Entangle Incantation: Commit Effort for the scene as an Instant action when an foe within 60’ incants a spell. Your voice tangles with their words, forcing them to make an opposed Int/Magic vs Cha/Perform skill check against you, with a +2 bonus to your roll. If you tie or succeed, the spell fizzles and is wasted. This art can be used only once per round.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an Instant action when an foe within 60’ incants a spell. Your voice tangles with their words, forcing them to make an opposed Int/Magic vs Cha/Perform skill check against you, with a +2 bonus to your roll. If you tie or succeed, the spell fizzles and is wasted. This art can be used only once per round."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/erudite",
      "@type": "Art",
      "name": "Erudite",
      "slug": "erudite",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "General Arts",
        "lineStart": 2281,
        "lineEnd": 2281
      },
      "rulesText": "Erudite: You are uncommonly learned. Once per day, reroll a failed skill check related to intellectual pursuits or things a scholar would know about.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "You are uncommonly learned. Once per day, reroll a failed skill check related to intellectual pursuits or things a scholar would know about."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/evil-eye",
      "@type": "Art",
      "name": "Evil Eye",
      "slug": "evil-eye",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Curses and Blessings",
        "lineStart": 2369,
        "lineEnd": 2369
      },
      "rulesText": "Evil Eye: This art improves your curse and blessing arts. You can now use these arts as an Instant action, albeit still only one such art per round, and you need do no more than look at the target rather than vocalizing any particular curse or blessing.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "This art improves your curse and blessing arts. You can now use these arts as an Instant action, albeit still only one such art per round, and you need do no more than look at the target rather than vocalizing any particular curse or blessing."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/evoke-emotion",
      "@type": "Art",
      "name": "Evoke Emotion",
      "slug": "evoke-emotion",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.3.1",
        "heading": "1.5.3.1 Bard Arts",
        "lineStart": 665,
        "lineEnd": 665
      },
      "rulesText": "Evoke Emotion: Commit Effort for the day as a Main Action while performing. You evoke a desired emotion in listeners, whether intelligent or animal, granting a +1 bonus to relevant social skill checks for the scene for you and your allies. If desired, you can force a new Reaction Roll, taking it if it’s more favorable than the original. This art does not work in combat and can be used only once per scene.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/bard"
      },
      "traditionName": "bard",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action while performing. You evoke a desired emotion in listeners, whether intelligent or animal, granting a +1 bonus to relevant social skill checks for the scene for you and your allies. If desired, you can force a new Reaction Roll, taking it if it’s more favorable than the original. This art does not work in combat and can be used only once per scene."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/eyes-of-the-beast",
      "@type": "Art",
      "name": "Eyes of the Beast",
      "slug": "eyes-of-the-beast",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Other Beastmaster Arts",
        "lineStart": 816,
        "lineEnd": 816
      },
      "rulesText": "Eyes of the Beast: Commit Effort for the scene as an On Turn action. For the rest of the scene, you can share the senses of your companion. Neither of you can be surprised unless both are surprised.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action. For the rest of the scene, you can share the senses of your companion. Neither of you can be surprised unless both are surprised."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/eyes-of-the-hawk",
      "@type": "Art",
      "name": "Eyes of the Hawk",
      "slug": "eyes-of-the-hawk",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1915,
        "lineEnd": 1915
      },
      "rulesText": "Eyes of the Hawk: This shape has remarkably acute senses. You can scent trails and objects like a dog, hear very faint noises, see objects clearly enough to identify faces at a thousand feet of distance, and see clearly in anything short of complete darkness. You gain a +2 bonus on all sensory Notice checks.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This shape has remarkably acute senses. You can scent trails and objects like a dog, hear very faint noises, see objects clearly enough to identify faces at a thousand feet of distance, and see clearly in anything short of complete darkness. You gain a +2 bonus on all sensory Notice checks."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/facile-healer",
      "@type": "Art",
      "name": "Facile Healer",
      "slug": "facile-healer",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Other Healer Arts",
        "lineStart": 1294,
        "lineEnd": 1294
      },
      "rulesText": "Facile Healer: Your Healing Touch ability is improved;, and you no longer need to Commit Effort to activate it.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Your Healing Touch ability is improved;, and you no longer need to Commit Effort to activate it."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/facile-speech",
      "@type": "Art",
      "name": "Facile Speech",
      "slug": "facile-speech",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Other Thought Noble Arts",
        "lineStart": 1982,
        "lineEnd": 1982
      },
      "rulesText": "Facile Speech: An improvement to the Far Speech art, you may now nominate up to a half-dozen companions to be favored targets for Far Speech. You may link with a favored target as an On Turn action without Committing Effort. The range to contact a favored target is one mile per Thought Noble level. You can change your nominated companions with an hour’s meditation in the new companion’s presence.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "An improvement to the Far Speech art, you may now nominate up to a half-dozen companions to be favored targets for Far Speech. You may link with a favored target as an On Turn action without Committing Effort. The range to contact a favored target is one mile per Thought Noble level. You can change your nominated companions with an hour’s meditation in the new companion’s presence."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/false-death",
      "@type": "Art",
      "name": "False Death",
      "slug": "false-death",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "1.5.14.1 Necromancer Arts",
        "lineStart": 1730,
        "lineEnd": 1730
      },
      "rulesText": "False Death: Commit Effort as an Instant action; while it remains Committed you appear dead to all mundane examination. You lose your Main Actions while “dead”, but can move and perceive normally and do not need to eat, drink, breathe, or perform other bodily functions. Poisons and diseases do not progress in you while you are “dead”. You can maintain this state of death for up to one day per level before needing at least an hour to recover.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "Commit Effort as an Instant action; while it remains Committed you appear dead to all mundane examination. You lose your Main Actions while “dead”, but can move and perceive normally and do not need to eat, drink, breathe, or perform other bodily functions. Poisons and diseases do not progress in you while you are “dead”. You can maintain this state of death for up to one day per level before needing at least an hour to recover."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/far-healer",
      "@type": "Art",
      "name": "Far Healer",
      "slug": "far-healer",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Other Healer Arts",
        "lineStart": 1296,
        "lineEnd": 1296
      },
      "rulesText": "Far Healer: Your Healing Touch ability is improved, and may be used on a visible target within ten feet per character level.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Your Healing Touch ability is improved, and may be used on a visible target within ten feet per character level."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/far-speech",
      "@type": "Art",
      "name": "Far Speech",
      "slug": "far-speech",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2029,
        "lineEnd": 2029
      },
      "rulesText": "Far Speech: Commit Effort for the scene as an On Turn action and target an intelligent creature known to you that is within two hundred feet per level. If they consent, you forge a telepathic link with them that can convey thoughts, speech, and images even without a common language. The link lasts for the rest of the scene. While linked with someone, both of you may reroll failed Mental saving throws and neither of you can be surprised unless both are.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action and target an intelligent creature known to you that is within two hundred feet per level. If they consent, you forge a telepathic link with them that can convey thoughts, speech, and images even without a common language. The link lasts for the rest of the scene. While linked with someone, both of you may reroll failed Mental saving throws and neither of you can be surprised unless both are."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/faultless-awareness",
      "@type": "Art",
      "name": "Faultless Awareness",
      "slug": "faultless-awareness",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2143,
        "lineEnd": 2143
      },
      "rulesText": "Faultless Awareness: Your awareness is such that you cannot be surprised, and will even wake from a sound sleep in time to respond normally to some imminent peril.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "Your awareness is such that you cannot be surprised, and will even wake from a sound sleep in time to respond normally to some imminent peril."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/favored-weapon",
      "@type": "Art",
      "name": "Favored Weapon",
      "slug": "favored-weapon",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "1.5.6.1 Duelist Arts",
        "lineStart": 975,
        "lineEnd": 975
      },
      "rulesText": "Favored Weapon: Choose one specific type of non-unarmed melee weapon. You begin play with such a weapon, and when using this type you may use the Favored Weapon attack bonus column on the Duelist table to determine your base hit bonus, unless it’s already better for some other reason. If your second partial class is Partial Warrior, your class’ base hit bonus with the weapon is instead equal to your level. You cannot apply this or other Duelist arts to thrown weapons.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Choose one specific type of non-unarmed melee weapon. You begin play with such a weapon, and when using this type you may use the Favored Weapon attack bonus column on the Duelist table to determine your base hit bonus, unless it’s already better for some other reason. If your second partial class is Partial Warrior, your class’ base hit bonus with the weapon is instead equal to your level. You cannot apply this or other Duelist arts to thrown weapons."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/fear-no-flame",
      "@type": "Art",
      "name": "Fear No Flame",
      "slug": "fear-no-flame",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "1.5.5.1 Blood Priest Arts",
        "lineStart": 873,
        "lineEnd": 873
      },
      "rulesText": "Fear No Flame: Commit Effort for the day as an On Turn action while nominating a visible target. For the rest of the scene, they are immune to non-magical flame, smoke, or explosive damage, and decrease any sources of such magical damage they take by five points per level of Pray you have.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an On Turn action while nominating a visible target. For the rest of the scene, they are immune to non-magical flame, smoke, or explosive damage, and decrease any sources of such magical damage they take by five points per level of Pray you have."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/feline-leap",
      "@type": "Art",
      "name": "Feline Leap",
      "slug": "feline-leap",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1917,
        "lineEnd": 1917
      },
      "rulesText": "Feline Leap: This form can vault great distances. You can jump your full Move rating as a Move action, crossing the full distance horizontally or up to half the distance vertically. You subtract your Move rating from fall distance for damage calculations.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This form can vault great distances. You can jump your full Move rating as a Move action, crossing the full distance horizontally or up to half the distance vertically. You subtract your Move rating from fall distance for damage calculations."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/feral-prowess",
      "@type": "Art",
      "name": "Feral Prowess",
      "slug": "feral-prowess",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.15.1",
        "heading": "Other Skinshifter Arts",
        "lineStart": 1919,
        "lineEnd": 1919
      },
      "rulesText": "Feral Prowess: This form has an augmented degree of speed, strength, or hardiness. For this form, pick either Strength, Dexterity, or Constitution; that attribute modifier is improved by +1 in this form, to a maximum of +2. These alterations are obvious and extreme; it is impossible to masquerade as a normal baseline human if using this art. Hit points gained from Con improvements are lost when shifting back.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/skinshifter"
      },
      "traditionName": "skinshifter",
      "effects": [
        {
          "sourceText": "This form has an augmented degree of speed, strength, or hardiness. For this form, pick either Strength, Dexterity, or Constitution; that attribute modifier is improved by +1 in this form, to a maximum of +2. These alterations are obvious and extreme; it is impossible to masquerade as a normal baseline human if using this art. Hit points gained from Con improvements are lost when shifting back."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/feral-toughness",
      "@type": "Art",
      "name": "Feral Toughness",
      "slug": "feral-toughness",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Other Beastmaster Arts",
        "lineStart": 818,
        "lineEnd": 818
      },
      "rulesText": "Feral Toughness: Your maximum hit point total is increased by the natural, unmodified hit dice of your companion; thus, a 5 hit die companion increases your maximum hit points by 5. You are impervious to normal outdoor extremes of heat or cold. Your base Armor Class is equal to 13 plus half your level, rounded up. This AC can be modified by shields or Dexterity modifiers, but not by armor.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "Your maximum hit point total is increased by the natural, unmodified hit dice of your companion; thus, a 5 hit die companion increases your maximum hit points by 5. You are impervious to normal outdoor extremes of heat or cold. Your base Armor Class is equal to 13 plus half your level, rounded up. This AC can be modified by shields or Dexterity modifiers, but not by armor."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/final-repose",
      "@type": "Art",
      "name": "Final Repose",
      "slug": "final-repose",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Other Healer Arts",
        "lineStart": 1298,
        "lineEnd": 1298
      },
      "rulesText": "Final Repose: Target a visible living creature and Commit Effort for the day as an Instant action. For the rest of the scene, they take a Physical saving throw penalty equal to your Heal skill. If they are reduced to zero hit points before the end of the scene, they die with no chance for stabilization or revival.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Target a visible living creature and Commit Effort for the day as an Instant action. For the rest of the scene, they take a Physical saving throw penalty equal to your Heal skill. If they are reduced to zero hit points before the end of the scene, they die with no chance for stabilization or revival."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/find-object",
      "@type": "Art",
      "name": "Find Object",
      "slug": "find-object",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Divination Arts",
        "lineStart": 2359,
        "lineEnd": 2359
      },
      "rulesText": "Find Object: The diviner spends a scene performing a ritual to locate a particular animal, object or type of substance known to them, be it gold, water, or a specific stolen cow. People cannot be found with this art. The GM makes a secret Wis/Magic skill check against a difficulty of 8 to 11, depending on how close the nearest suitable object is; something in the same village is 8, something a mile or more away is 11, and something more than five miles away is undetectable. If the check is successful, the diviner gets an impression of the direction the object is in. On a failure, roll 1d12 and use it as a clock face to give a random direction. This art can be used once per day.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "The diviner spends a scene performing a ritual to locate a particular animal, object or type of substance known to them, be it gold, water, or a specific stolen cow. People cannot be found with this art. The GM makes a secret Wis/Magic skill check against a difficulty of 8 to 11, depending on how close the nearest suitable object is; something in the same village is 8, something a mile or more away is 11, and something more than five miles away is undetectable. If the check is successful, the diviner gets an impression of the direction the object is in. On a failure, roll 1d12 and use it as a clock face to give a random direction. This art can be used once per day."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/flamesight",
      "@type": "Art",
      "name": "Flamesight",
      "slug": "flamesight",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.7.1",
        "heading": "Partial Elementalist Arts and Spells",
        "lineStart": 1142,
        "lineEnd": 1142
      },
      "rulesText": "Flamesight: Commit Effort as an On Turn action. While the Effort remains Committed, you can see thermal gradients sufficient to distinguish surfaces and living creatures, even in perfect darkness. Optionally, you may cause your own eyes to cast a light sufficient to illuminate your surroundings clearly out to a range of 30 feet.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/elementalist"
      },
      "traditionName": "elementalist",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action. While the Effort remains Committed, you can see thermal gradients sufficient to distinguish surfaces and living creatures, even in perfect darkness. Optionally, you may cause your own eyes to cast a light sufficient to illuminate your surroundings clearly out to a range of 30 feet."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/folk-friend",
      "@type": "Art",
      "name": "Folk-Friend",
      "slug": "folk-friend",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "General Arts",
        "lineStart": 2283,
        "lineEnd": 2283
      },
      "rulesText": "Folk-Friend: Commoners and other lower-class natives consider you a useful healer and helper. Once per day, get a modest favor from a commoner who doesn’t hate you in exchange for a blessing or bit of advice.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "Commoners and other lower-class natives consider you a useful healer and helper. Once per day, get a modest favor from a commoner who doesn’t hate you in exchange for a blessing or bit of advice."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/forced-engagement",
      "@type": "Art",
      "name": "Forced Engagement",
      "slug": "forced-engagement",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1036,
        "lineEnd": 1036
      },
      "rulesText": "Forced Engagement: Commit Effort for the scene as an Instant action when making an attack with your favored weapon; you may ignore one foe’s Screen Ally action for that attack.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an Instant action when making an attack with your favored weapon; you may ignore one foe’s Screen Ally action for that attack."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/gentleman-s-withdrawal",
      "@type": "Art",
      "name": "Gentleman’s Withdrawal",
      "slug": "gentleman-s-withdrawal",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1038,
        "lineEnd": 1038
      },
      "rulesText": "Gentleman’s Withdrawal: Commit Effort for the scene as a Move action. As part of this, you may move at your full movement rate without being hindered by armed foes unless they completely block your path. You count as having made a Fighting Withdrawal against any enemies engaged with you at the time.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Move action. As part of this, you may move at your full movement rate without being hindered by armed foes unless they completely block your path. You count as having made a Fighting Withdrawal against any enemies engaged with you at the time."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/god-wills-it",
      "@type": "Art",
      "name": "God Wills It",
      "slug": "god-wills-it",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.5.1",
        "heading": "1.5.5.1 Blood Priest Arts",
        "lineStart": 875,
        "lineEnd": 875
      },
      "rulesText": "God Wills It: Commit Effort for the day as an Instant action and loudly call down your god’s blessing on your comrades. For the rest of the scene, up to six allies per character level in earshot gain an effective Morale of 12 and a +1 bonus to hit and damage rolls, including any Shock that may be inflicted. At fifth level this becomes a +2 bonus, and at tenth level it becomes a +3 bonus.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/blood-priest"
      },
      "traditionName": "blood-priest",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as an Instant action and loudly call down your god’s blessing on your comrades. For the rest of the scene, up to six allies per character level in earshot gain an effective Morale of 12 and a +1 bonus to hit and damage rolls, including any Shock that may be inflicted. At fifth level this becomes a +2 bonus, and at tenth level it becomes a +3 bonus."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/graceful-leap",
      "@type": "Art",
      "name": "Graceful Leap",
      "slug": "graceful-leap",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.6.1",
        "heading": "Partial Warrior/Duelist",
        "lineStart": 1040,
        "lineEnd": 1040
      },
      "rulesText": "Graceful Leap: Commit Effort for the scene as an On Turn action to immediately leap up to ten feet horizontally or vertically, counting it as a Fighting Withdrawal. You can’t use this art more than once per round or after you’ve attacked. You are immune to falling damage from plunges of less than 30 feet.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/duelist"
      },
      "traditionName": "duelist",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an On Turn action to immediately leap up to ten feet horizontally or vertically, counting it as a Fighting Withdrawal. You can’t use this art more than once per round or after you’ve attacked. You are immune to falling damage from plunges of less than 30 feet."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/gravesight",
      "@type": "Art",
      "name": "Gravesight",
      "slug": "gravesight",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.14.1",
        "heading": "1.5.14.1 Necromancer Arts",
        "lineStart": 1732,
        "lineEnd": 1732
      },
      "rulesText": "Gravesight: Commit Effort as an On Turn action; while it remains Committed, you can see the life energies of living creatures around you as various glowing patterns, regardless of the mundane illumination available. You can perceive sicknesses, poisons, and other physical qualities on sight. As a side effect of this ability, you can see normally even in perfect blackness.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/necromancer"
      },
      "traditionName": "necromancer",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action; while it remains Committed, you can see the life energies of living creatures around you as various glowing patterns, regardless of the mundane illumination available. You can perceive sicknesses, poisons, and other physical qualities on sight. As a side effect of this ability, you can see normally even in perfect blackness."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/hang-sorcery",
      "@type": "Art",
      "name": "Hang Sorcery",
      "slug": "hang-sorcery",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "1.5.10.1 High Mage Arts",
        "lineStart": 1402,
        "lineEnd": 1402
      },
      "rulesText": "Hang Sorcery: Commit Effort for the scene as an Instant action when casting a spell. The spell does not go off, but remains “hung” and waiting to be triggered as an On Turn action, with details of targeting and effect determined at that time. Damage does not disrupt a hung spell, but no additional spells can be cast until the hung spell is released or allowed to dissipate.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an Instant action when casting a spell. The spell does not go off, but remains “hung” and waiting to be triggered as an On Turn action, with details of targeting and effect determined at that time. Damage does not disrupt a hung spell, but no additional spells can be cast until the hung spell is released or allowed to dissipate."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/healer-arts",
      "@type": "Art",
      "name": "Healer Arts",
      "slug": "healer-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "1.5.9.1 Healer Arts",
        "lineStart": 1282,
        "lineEnd": 1289
      },
      "rulesText": "Healer Effort is calculated with Heal rather than Magic, with each PC’s maximum being equal to their Heal skill level plus the better of their Intelligence or Charisma modifiers, to a minimum of one point.\n\nAll Healers are trained in the Healing Touch art, but may develop other techniques with time.\n\nHealing Touch: Commit Effort for the scene as an Instant action; for the rest of the scene, you may heal 2d6 damage plus your Heal skill to a touched ally as a Main Action. This healing adds 1 System Strain to the target each time it is applied.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Healer Effort is calculated with Heal rather than Magic, with each PC’s maximum being equal to their Heal skill level plus the better of their Intelligence or Charisma modifiers, to a minimum of one point.\n\nAll Healers are trained in the Healing Touch art, but may develop other techniques with time.\n\nHealing Touch: Commit Effort for the scene as an Instant action; for the rest of the scene, you may heal 2d6 damage plus your Heal skill to a touched ally as a Main Action. This healing adds 1 System Strain to the target each time it is applied."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/healer-s-eye",
      "@type": "Art",
      "name": "Healer’s Eye",
      "slug": "healer-s-eye",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "Other Healer Arts",
        "lineStart": 1300,
        "lineEnd": 1300
      },
      "rulesText": "Healer’s Eye: Commit Effort as an On Turn action; while the Effort remains committed, you can use a Main Action to visually detect diseases and poisons, diagnose creatures flawlessly, perceive their physiology, and learn their current hit point totals. As a side effect, you can detect living creatures by sight regardless of available light or obscuring mists.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Commit Effort as an On Turn action; while the Effort remains committed, you can use a Main Action to visually detect diseases and poisons, diagnose creatures flawlessly, perceive their physiology, and learn their current hit point totals. As a side effect, you can detect living creatures by sight regardless of available light or obscuring mists."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/healer",
      "@type": "Art",
      "name": "Healer",
      "slug": "healer",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Example Art Progressions for Different Types of Wise",
        "lineStart": 2345,
        "lineEnd": 2345
      },
      "rulesText": "Healer: You are a trained and capable healer. Gain a +1 on all Heal skill checks; once per day, as an On Turn action, automatically succeed at a skill check to stabilize a Mortally Wounded subject.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "You are a trained and capable healer. Gain a +1 on all Heal skill checks; once per day, as an On Turn action, automatically succeed at a skill check to stabilize a Mortally Wounded subject."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/healing-touch",
      "@type": "Art",
      "name": "Healing Touch",
      "slug": "healing-touch",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.9.1",
        "heading": "1.5.9.1 Healer Arts",
        "lineStart": 1288,
        "lineEnd": 1288
      },
      "rulesText": "Healing Touch: Commit Effort for the scene as an Instant action; for the rest of the scene, you may heal 2d6 damage plus your Heal skill to a touched ally as a Main Action. This healing adds 1 System Strain to the target each time it is applied.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/healer"
      },
      "traditionName": "healer",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as an Instant action; for the rest of the scene, you may heal 2d6 damage plus your Heal skill to a touched ally as a Main Action. This healing adds 1 System Strain to the target each time it is applied."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/high-mage-arts",
      "@type": "Art",
      "name": "High Mage Arts",
      "slug": "high-mage-arts",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.10.1",
        "heading": "1.5.10.1 High Mage Arts",
        "lineStart": 1392,
        "lineEnd": 1409
      },
      "rulesText": "High Mage Effort is calculated as usual, with each PC’s maximum being equal to one plus their Magic skill level plus the better of their Intelligence or Charisma modifiers. Partial High Mages have a score one point lower than this, albeit not less than one.\n\nArcane Lexicon: Commit Effort for the scene. For the rest of the scene, you can read any script that was not intentionally obfuscated or encoded by its writer. Extremely esoteric or nonhuman scripts may not be comprehensible this way; the “plain meaning” of the text might be utterly foreign to human logic.\n\nCounter Magic: Commit Effort for the day as an Instant action when a visible enemy mage casts a spell. Both of you make opposed Int/Magic or Cha/Magic skill checks; if you win, their spell fizzles and is wasted. This art only works on actual spellcasters and not creatures that merely activate magical powers. You can use this art no more than once per round.\n\nEmpowered Sorcery: Commit Effort for the day as an Instant action to re-roll any variable die roll associated with a spell’s effects, such as a damage roll; take the roll you prefer.\n\nHang Sorcery: Commit Effort for the scene as an Instant action when casting a spell. The spell does not go off, but remains “hung” and waiting to be triggered as an On Turn action, with details of targeting and effect determined at that time. Damage does not disrupt a hung spell, but no additional spells can be cast until the hung spell is released or allowed to dissipate.\n\nInexorable Effect: Commit Effort for the day as an Instant action to force an enemy to re-roll a successful saving throw and take the worse result. You may use this art only once per scene.\n\nIron Resolution: Commit Effort for the day when injured or disturbed in combat; you may make a Physical saving throw to resist spell disruption and ignore the damage for purposes of spellcasting.\n\nPreparatory Countermagic: Commit Effort for the scene when you are affected by a spell you have prepared, including when you are standing in the area of effect of one of your own damaging spells. You are unaffected by the spell’s direct effects.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/high-mage"
      },
      "traditionName": "high-mage",
      "effects": [
        {
          "sourceText": "High Mage Effort is calculated as usual, with each PC’s maximum being equal to one plus their Magic skill level plus the better of their Intelligence or Charisma modifiers. Partial High Mages have a score one point lower than this, albeit not less than one.\n\nArcane Lexicon: Commit Effort for the scene. For the rest of the scene, you can read any script that was not intentionally obfuscated or encoded by its writer. Extremely esoteric or nonhuman scripts may not be comprehensible this way; the “plain meaning” of the text might be utterly foreign to human logic.\n\nCounter Magic: Commit Effort for the day as an Instant action when a visible enemy mage casts a spell. Both of you make opposed Int/Magic or Cha/Magic skill checks; if you win, their spell fizzles and is wasted. This art only works on actual spellcasters and not creatures that merely activate magical powers. You can use this art no more than once per round.\n\nEmpowered Sorcery: Commit Effort for the day as an Instant action to re-roll any variable die roll associated with a spell’s effects, such as a damage roll; take the roll you prefer.\n\nHang Sorcery: Commit Effort for the scene as an Instant action when casting a spell. The spell does not go off, but remains “hung” and waiting to be triggered as an On Turn action, with details of targeting and effect determined at that time. Damage does not disrupt a hung spell, but no additional spells can be cast until the hung spell is released or allowed to dissipate.\n\nInexorable Effect: Commit Effort for the day as an Instant action to force an enemy to re-roll a successful saving throw and take the worse result. You may use this art only once per scene.\n\nIron Resolution: Commit Effort for the day when injured or disturbed in combat; you may make a Physical saving throw to resist spell disruption and ignore the damage for purposes of spellcasting.\n\nPreparatory Countermagic: Commit Effort for the scene when you are affected by a spell you have prepared, including when you are standing in the area of effect of one of your own damaging spells. You are unaffected by the spell’s direct effects."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/holy-sanctity",
      "@type": "Art",
      "name": "Holy Sanctity",
      "slug": "holy-sanctity",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Example Art Progressions for Different Types of Wise",
        "lineStart": 2347,
        "lineEnd": 2347
      },
      "rulesText": "Holy Sanctity: You are honored and respected by most in this region. Gain a +1 bonus on social skill checks with locals who are not naturally opposed to your religion or social institution.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "You are honored and respected by most in this region. Gain a +1 bonus on social skill checks with locals who are not naturally opposed to your religion or social institution."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/howl-of-distant-summons",
      "@type": "Art",
      "name": "Howl of Distant Summons",
      "slug": "howl-of-distant-summons",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.4.1",
        "heading": "Other Beastmaster Arts",
        "lineStart": 820,
        "lineEnd": 820
      },
      "rulesText": "Howl of Distant Summons: You can call former animal companions to your side by Committing Effort for the day as a Main Action. The howl extends through time as well as space, and the subject will have received the message in time to reach your side within five minutes after you call for it. Once summoned, you may bind it again if you have no current companion. If the journey is exceptionally dangerous, difficult, or long, you’ll need to make a Cha/Survive skill check against a difficulty of 10 or more; on a failure, the beast could not make the journey and cannot be called by this power for another week.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/beastmaster"
      },
      "traditionName": "beastmaster",
      "effects": [
        {
          "sourceText": "You can call former animal companions to your side by Committing Effort for the day as a Main Action. The howl extends through time as well as space, and the subject will have received the message in time to reach your side within five minutes after you call for it. Once summoned, you may bind it again if you have no current companion. If the journey is exceptionally dangerous, difficult, or long, you’ll need to make a Cha/Survive skill check against a difficulty of 10 or more; on a failure, the beast could not make the journey and cannot be called by this power for another week."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/hurling-throw",
      "@type": "Art",
      "name": "Hurling Throw",
      "slug": "hurling-throw",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.17.1",
        "heading": "Partial Warrior/Vowed",
        "lineStart": 2145,
        "lineEnd": 2145
      },
      "rulesText": "Hurling Throw: After you make a successful attack, you may Commit Effort for the scene as an Instant action. The target must make a Physical saving throw or be thrown up to ten feet in any direction, falling prone on landing and suffering the damage rolled for your attack. If the Physical save is successful, the target simply takes damage as normal. This art can be used only once per round on any given target, and the target must be no larger than an ox.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/vowed"
      },
      "traditionName": "vowed",
      "effects": [
        {
          "sourceText": "After you make a successful attack, you may Commit Effort for the scene as an Instant action. The target must make a Physical saving throw or be thrown up to ten feet in any direction, falling prone on landing and suffering the damage rolled for your attack. If the Physical save is successful, the target simply takes damage as normal. This art can be used only once per round on any given target, and the target must be no larger than an ox."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/hypercognition",
      "@type": "Art",
      "name": "Hypercognition",
      "slug": "hypercognition",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2031,
        "lineEnd": 2031
      },
      "rulesText": "Hypercognition: You can drive your mind to tremendous feats of calculation, estimation, and recall. You have an eidetic memory and can perform extremely advanced calculations in your head. As an Instant action, Commit Effort for the day and reroll any failed Int-based skill check. This ability can be used only once on any given check.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "You can drive your mind to tremendous feats of calculation, estimation, and recall. You have an eidetic memory and can perform extremely advanced calculations in your head. As an Instant action, Commit Effort for the day and reroll any failed Int-based skill check. This ability can be used only once on any given check."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/iconograph",
      "@type": "Art",
      "name": "Iconograph",
      "slug": "iconograph",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2033,
        "lineEnd": 2033
      },
      "rulesText": "Iconograph: Commit Effort for the scene as a Main Action and target a visible written text, piece of sculpture, iconographic symbol, or other visible artifact. You receive a short description of the message or idea the maker was trying to convey with the object. Optionally, you may use this art when making a sigil, art object, or text of your own; any valid target will automatically understand your intended message when they see the item. You may restrict your audience to particular people or types if you wish.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Commit Effort for the scene as a Main Action and target a visible written text, piece of sculpture, iconographic symbol, or other visible artifact. You receive a short description of the message or idea the maker was trying to convey with the object. Optionally, you may use this art when making a sigil, art object, or text of your own; any valid target will automatically understand your intended message when they see the item. You may restrict your audience to particular people or types if you wish."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/ill-fate",
      "@type": "Art",
      "name": "Ill Fate",
      "slug": "ill-fate",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19.1",
        "heading": "Curses and Blessings",
        "lineStart": 2371,
        "lineEnd": 2371
      },
      "rulesText": "Ill Fate: As a Main Action, curse a visible target. You may specify a particular kind of undertaking or apply the curse to anything they may do. The next pertinent skill check they make is made at a -1 penalty. If their raw die roll is equal or less than the PC’s Magic skill plus one their effort goes disastrously wrong. The curse lasts until the next relevant skill check.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise"
      },
      "traditionName": "wise",
      "effects": [
        {
          "sourceText": "As a Main Action, curse a visible target. You may specify a particular kind of undertaking or apply the curse to anything they may do. The next pertinent skill check they make is made at a -1 penalty. If their raw die roll is equal or less than the PC’s Magic skill plus one their effort goes disastrously wrong. The curse lasts until the next relevant skill check."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/immaculate-body",
      "@type": "Art",
      "name": "Immaculate Body",
      "slug": "immaculate-body",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "Mageslayer Art Progression",
        "lineStart": 1690,
        "lineEnd": 1690
      },
      "rulesText": "Immaculate Body: Magical transformations, curses, or lingering negative magical penalties last a maximum of one scene on you. Such malisons cannot kill you, reducing you to 1 HP at worst. This applies to all magical effects, and not only to hostile spells.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "Magical transformations, curses, or lingering negative magical penalties last a maximum of one scene on you. Such malisons cannot kill you, reducing you to 1 HP at worst. This applies to all magical effects, and not only to hostile spells."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/immaculate-mind",
      "@type": "Art",
      "name": "Immaculate Mind",
      "slug": "immaculate-mind",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.13.1",
        "heading": "Mageslayer Art Progression",
        "lineStart": 1692,
        "lineEnd": 1692
      },
      "rulesText": "Immaculate Mind: You are impervious to unwanted mind-affecting or mind-reading spells or magical effects, and you automatically see through illusions and magical invisibility. Note that this applies to all such magical effects, not merely spells.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/mageslayer"
      },
      "traditionName": "mageslayer",
      "effects": [
        {
          "sourceText": "You are impervious to unwanted mind-affecting or mind-reading spells or magical effects, and you automatically see through illusions and magical invisibility. Note that this applies to all such magical effects, not merely spells."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/impress-imperative",
      "@type": "Art",
      "name": "Impress Imperative",
      "slug": "impress-imperative",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.16.1",
        "heading": "Partial Warrior/Thought Noble",
        "lineStart": 2035,
        "lineEnd": 2035
      },
      "rulesText": "Impress Imperative: Commit Effort for the day as a Main Action while targeting a visible living creature. You may give it an overwhelming urge to perform some action that takes no longer than a round and is not completely contrary to its nature or wishes. It can make a Mental save to resist, but on a failure it spends its next action carrying out the imperative.",
      "tradition": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/thought-noble"
      },
      "traditionName": "thought-noble",
      "effects": [
        {
          "sourceText": "Commit Effort for the day as a Main Action while targeting a visible living creature. You may give it an overwhelming urge to perform some action that takes no longer than a round and is not completely contrary to its nature or wishes. It can make a Mental save to resist, but on a failure it spends its next action carrying out the imperative."
        }
      ]
    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/arts/inexorable-effect",
      "@type": "Art",
      "name": "Inexorable Effect",
