    },
    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/rules/1-5-10-1-partial-warrior-high-mage",
      "@type": "Rule",
      "name": "Partial Warrior/High Mage",
      "slug": "1-5-10-1-partial-warrior-high-mage",
      "source": {
