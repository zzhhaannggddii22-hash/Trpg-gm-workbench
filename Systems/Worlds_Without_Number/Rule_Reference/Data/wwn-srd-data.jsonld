    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/invoker",
      "@type": "Class",
      "name": "Invoker",
      "slug": "invoker",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.11",
        "heading": "1.5.11 The Invoker",
        "lineStart": 1516,
        "lineEnd": 1519
      },
      "rulesText": "The Invoker is an optional spellcasting Mage class that allows a caster to gain flexibility in casting weaker spells. In exchange, an Invoker sacrifices arts and finds more powerful spells to be more draining to cast.",
      "classKind": "partial",
      "benefits": [
        {
          "sourceText": "The Invoker is an optional spellcasting Mage class that allows a caster to gain flexibility in casting weaker spells. In exchange, an Invoker sacrifices arts and finds more powerful spells to be more draining to cast."
