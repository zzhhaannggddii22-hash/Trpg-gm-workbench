    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1",
      "@type": "Source",
      "name": "Worlds Without Number System Reference Document",
      "slug": "wwn-srd-v1",
      "description": "Systems Reference Document v1.0 for Worlds Without Number.",
      "rulesText": "The source document is the repository's SRD.md file.",
      "sourceLocator": {
        "section": "front-matter",
        "heading": "Worlds Without Number System Reference Document v1.0"
      },
      "author": "Kevin Crawford",
      "version": "1.0",
