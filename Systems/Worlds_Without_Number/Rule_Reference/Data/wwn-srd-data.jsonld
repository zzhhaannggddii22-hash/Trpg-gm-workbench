      },
      "sourceLocator": {
        "section": "7.3.0",
        "heading": "7.3.0 Determining the Project Scope",
        "lineStart": 5249,
        "lineEnd": 5272
      },
      "tableType": "7.3.0 Determining the Project Scope",
      "columns": [
        "Probability of the Goal",
