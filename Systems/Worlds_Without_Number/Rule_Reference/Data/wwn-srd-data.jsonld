    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/wise",
      "@type": "Class",
      "name": "Wise",
      "slug": "wise",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.19",
        "heading": "1.5.19 The Wise",
        "lineStart": 2251,
        "lineEnd": 2258
      },
      "rulesText": "Some low-magic settings have a particular place for concepts that aren’t exactly magical, but have some special place in society. Whether a mundane priest of the dominant faith, a feared forest warlock, or a sacred oracle of the gods, these Wise have a special role to fill.\n\nSome of these Wise may have very minor or subtle magical powers suitable to a low-magic campaign setting.\n\nIn general, the Wise class is usually only viable in a low- or no-magic setting where their limited powers are still more than almost anyone else has access to. If standard magic exists in your campaign the Wise may not offer enough to appeal to players.",
      "classKind": "partial",
      "benefits": [
        {
          "sourceText": "Some low-magic settings have a particular place for concepts that aren’t exactly magical, but have some special place in society. Whether a mundane priest of the dominant faith, a feared forest warlock, or a sacred oracle of the gods, these Wise have a special role to fill.\n\nSome of these Wise may have very minor or subtle magical powers suitable to a low-magic campaign setting.\n\nIn general, the Wise class is usually only viable in a low- or no-magic setting where their limited powers are still more than almost anyone else has access to. If standard magic exists in your campaign the Wise may not offer enough to appeal to players."
        }
      ],
      "availableClassKinds": [
        "partial"
      ],
