    {
      "@context": "./context.jsonld",
      "@id": "https://cheeleong.dev/wwn-system-json/objects/classes/expert",
      "@type": "Class",
      "name": "Expert",
      "slug": "expert",
      "source": {
        "@id": "https://cheeleong.dev/wwn-system-json/objects/sources/wwn-srd-v1"
      },
      "sourceLocator": {
        "section": "1.5.8",
        "heading": "1.5.8 The Expert",
        "lineStart": 1201,
        "lineEnd": 1208
      },
      "rulesText": "Your hero is an expert at some useful skill. Thieves, diplomats, healers, scholars, explorers, artisans, and other such heroes should pick the Expert class if they wish to focus on developing their special skills and performing tremendous feats of mastery with them. Experts gain the widest variety of non-combat skills and are the quickest to learn more of them.\n\nAn Expert has an uncanny knack for wielding their skills successfully at a crucial moment, whether or not it’s a skill they’ve taken for their specialty. Once per scene, the Expert can reroll a failed non-combat skill check, gaining a second chance to yank victory from the jaws of otherwise certain failure. Their natural focus on personal development and determined refinement of their skills bleeds through even into those talents they don’t make their special domain.\n\nExperts are also capable combatants, fully able to hold their own in the midst of a murderous fray. It’s not unknown for some Experts to specialize in professions related to martial pursuits, such as an assassin who relies heavily on their superb powers of stealth and deception to reach their unwary foes.",
      "classKind": "full",
      "benefits": [
        {
          "sourceText": "Your hero is an expert at some useful skill. Thieves, diplomats, healers, scholars, explorers, artisans, and other such heroes should pick the Expert class if they wish to focus on developing their special skills and performing tremendous feats of mastery with them. Experts gain the widest variety of non-combat skills and are the quickest to learn more of them.\n\nAn Expert has an uncanny knack for wielding their skills successfully at a crucial moment, whether or not it’s a skill they’ve taken for their specialty. Once per scene, the Expert can reroll a failed non-combat skill check, gaining a second chance to yank victory from the jaws of otherwise certain failure. Their natural focus on personal development and determined refinement of their skills bleeds through even into those talents they don’t make their special domain.\n\nExperts are also capable combatants, fully able to hold their own in the midst of a murderous fray. It’s not unknown for some Experts to specialize in professions related to martial pursuits, such as an assassin who relies heavily on their superb powers of stealth and deception to reach their unwary foes."
        }
      ],
      "availableClassKinds": [
        "full",
        "partial"
      ],
